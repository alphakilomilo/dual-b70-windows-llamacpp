+// LLAMA_SPEC_QCAL=1 (diagnostic): for each verified draft position, the expected acceptance sum_x min(p(x), q_tau(x))
+// with q_tau = softmax(draft candidate scores / tau) for several tau, averaged and logged every 2000 positions; also
+// the mass of p on the draft's candidates (an upper bound for any tau) and the drafted token's p
+static const float spec_qcal_taus[] = { 0.25f, 0.4f, 0.55f, 0.7f, 0.85f, 1.0f, 1.2f, 1.5f, 2.0f };
+static constexpr int spec_qcal_n = sizeof(spec_qcal_taus) / sizeof(spec_qcal_taus[0]);
+struct spec_qcal_stats {
+    bool   on = getenv("LLAMA_SPEC_QCAL") != nullptr && atoi(getenv("LLAMA_SPEC_QCAL")) != 0;
+    double acc[spec_qcal_n] = {};
+    double cover = 0.0, p_top = 0.0;
+    long   n = 0;
+};
+static spec_qcal_stats g_qcal;
+
+static void spec_qcal_record(const llama_token_data_array * cur_p, const std::vector<llama_token_data> & q, float (*p_of)(const llama_token_data_array *, size_t, void *), void * ud) {
+    // p over the target's candidates (after the sampler chain)
+    double cover = 0.0;
+    std::vector<double> pq(q.size(), 0.0);
+    for (size_t k = 0; k < cur_p->size; ++k) {
+        const double pk = p_of(cur_p, k, ud);
+        for (size_t j = 0; j < q.size(); ++j) {
+            if (q[j].id == cur_p->data[k].id) {
+                pq[j] = pk;
+                cover += pk;
+                break;
+            }
+        }
+    }
+    float smax = -INFINITY;
+    size_t jmax = 0;
+    for (size_t j = 0; j < q.size(); ++j) {
+        if (q[j].logit > smax) { smax = q[j].logit; jmax = j; }
+    }
+    for (int t = 0; t < spec_qcal_n; ++t) {
+        double sum = 0.0;
+        std::vector<double> e(q.size());
+        for (size_t j = 0; j < q.size(); ++j) {
+            e[j] = std::exp((q[j].logit - smax) / spec_qcal_taus[t]);
+            sum += e[j];
+        }
+        double a = 0.0;
+        for (size_t j = 0; j < q.size(); ++j) {
+            a += std::min(pq[j], e[j] / sum);
+        }
+        g_qcal.acc[t] += a;
+    }
+    g_qcal.cover += cover;
+    g_qcal.p_top += pq[jmax];
