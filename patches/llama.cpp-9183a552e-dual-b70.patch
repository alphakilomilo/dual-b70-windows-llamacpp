+}  // namespace
+
+bool ggml_sycl_flash_attn_ext_xmx(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_FA_XMX", 0) == 1;
+    if (!enabled) {
+        return false;
+    }
+    const ggml_tensor * Q     = dst->src[0];
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    float scale = 1.0f, max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (Q->ne[0] != XD || K->ne[0] != XD || V->ne[0] != XD) {
+        return false;
+    }
+    if (K->ne[2] == 0 || Q->ne[2] != K->ne[2] * XG || V->ne[2] != K->ne[2]) {
+        return false;
+    }
+    if (Q->ne[1] < 1 || Q->ne[1] > XMAXTOK || Q->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1) {
+        return false;
+    }
+    if (K->ne[1] % XKT != 0 || V->ne[1] != K->ne[1]) {
+        return false;
+    }
+    if (!mask || mask->type != GGML_TYPE_F16 || mask->ne[0] < K->ne[1] || mask->ne[1] < Q->ne[1] || mask->ne[2] != 1 ||
+        mask->ne[3] != 1 || sinks || max_bias != 0.0f || logit_softcap != 0.0f) {
+        return false;
+    }
+    if (Q->nb[0] != sizeof(float) || K->nb[0] != sizeof(half) || V->nb[0] != sizeof(half) || mask->nb[0] != sizeof(half)) {
+        return false;
+    }
+    for (const ggml_tensor * t : { K, V }) {
+        if (t->nb[1] % sizeof(half) != 0 || t->nb[2] % sizeof(half) != 0) {
+            return false;
+        }
+    }
+    if (!ggml_is_contiguous(dst)) {
+        return false;
+    }
+
+    xmx_params p;
+    p.Q = (const char *) Q->data;          p.q_tok = Q->nb[1];                  p.q_head = Q->nb[2];
+    p.K = (const half *) K->data;          p.k_key = K->nb[1] / sizeof(half);   p.k_head = K->nb[2] / sizeof(half);
+    p.V = (const half *) V->data;          p.v_key = V->nb[1] / sizeof(half);   p.v_head = V->nb[2] / sizeof(half);
+    p.mask = (const half *) mask->data;    p.m_tok = mask->nb[1] / sizeof(half);
+    p.ntok = (int) Q->ne[1]; p.n_kv = (int) K->ne[1]; p.hkv = (int) K->ne[2];
+    p.scale = scale;
+    p.dst = (float *) dst->data;
+
+    // GGML_SYCL_FA_XMX_WIDE=0 keeps 8-token chunks for 9..64 tokens too (the previous behaviour)
+    static const bool wide = ggml_sycl_get_env("GGML_SYCL_FA_XMX_WIDE", 1) == 1;
+    static const bool stream = ggml_sycl_get_env("GGML_SYCL_FA_XMX_STREAM", 0) == 1;
+    static const bool narrow = ggml_sycl_get_env("GGML_SYCL_FA_XMX_NARROW_STREAM", 0) == 1;
+    static const bool narrow8 = ggml_sycl_get_env("GGML_SYCL_FA_XMX_NARROW_8", 0) == 1;
+    if (wide && stream && narrow && p.ntok >= (narrow8 ? 8 : 9) && p.ntok <= 16) {
+        const auto device = ctx.stream()->get_device();
+        // GGML_SYCL_FA_XMX_NARROW_96=1: 11..13 tokens on a 96-row tile with 48 subgroups, 14..16 on 128 rows with 64,
+        // instead of 128 rows with 32 subgroups (94K, per GPU: 12 tokens ~515 vs ~680 us, 16 tokens ~570 vs ~730)
+        static const bool narrow96 = ggml_sycl_get_env("GGML_SYCL_FA_XMX_NARROW_96", 0) == 1;
+        const int rows = p.ntok <= 10 ? wide_cfg<10>::R : (narrow96 && p.ntok <= 13 ? wide_cfg<16, 48>::R : wide_cfg<21>::R);
+        const size_t local_bytes = rows * (WKT * (sizeof(float) + sizeof(half)) + 3 * sizeof(float));
+        if (device.get_info<sycl::info::device::local_mem_size>() >= local_bytes &&
+            device.get_info<sycl::info::device::max_work_group_size>() >= 512) {
+            // GGML_SYCL_FA_XMX_NARROW_64=1 (diagnostic): 9..16 tokens on the 128-row tile with 64 subgroups
+            static const bool narrow64 = ggml_sycl_get_env("GGML_SYCL_FA_XMX_NARROW_64", 0) == 1;
+            if (narrow64 && device.get_info<sycl::info::device::max_work_group_size>() >= 64 * XSG) {
+                wide_attn_run<21, true, false, 64>(ctx, p);
+            } else if (p.ntok <= 10) {
+                static const bool local_query = ggml_sycl_get_env("GGML_SYCL_FA_XMX_LOCAL_QUERY", 0) == 1;
+                if (local_query && device.get_info<sycl::info::device::local_mem_size>() >= local_bytes + (size_t) rows * XD * sizeof(half)) {
+                    wide_attn_run<10, true, true>(ctx, p);
+                } else {
+                    wide_attn_run<10, true>(ctx, p);
+                }
+            } else if (narrow96 && p.ntok >= 14 && device.get_info<sycl::info::device::max_work_group_size>() >= 64 * XSG) {
+                // 14..16 tokens: the 128-row tile with 64 subgroups beats 96 rows / 48 (94K: 16 tokens ~570 vs ~630 us)
+                wide_attn_run<21, true, false, 64>(ctx, p);
+            } else if (narrow96 && device.get_info<sycl::info::device::max_work_group_size>() >= 48 * XSG) {
+                wide_attn_run<16, true, false, 48>(ctx, p);
+            } else {
+                wide_attn_run<21, true>(ctx, p);
+            }
+            return true;
+        }
+    }
+    if (p.ntok <= 8 || !wide) {
+        static const bool register_stats = ggml_sycl_get_env("GGML_SYCL_FA_XMX_BASE_REG_STATS", 0) == 1;
+        if (register_stats && p.ntok <= 8) {
+            xmx_attn_run<8, 16, true>(ctx, p);
+        } else {
+            xmx_attn_run<8, 16>(ctx, p);
+        }
+    } else {
+        const size_t slm = p.ntok > 32 ? 126720 : 76032;
+        const bool fits = stream && p.ntok >= 17 && p.ntok <= 48 &&
+                          ctx.stream()->get_device().get_info<sycl::info::device::local_mem_size>() >= slm &&
+                          ctx.stream()->get_device().get_info<sycl::info::device::max_work_group_size>() >= 512;
+        // 21 tokens: 126 rows padded to 128 instead of 192, 2/3 of the work for the 17-token (16-node tree) verify
+        if (stream && fits && p.ntok >= 17 && p.ntok <= 21) {
+            static const bool trim_padding = ggml_sycl_get_env("GGML_SYCL_FA_XMX_TRIM_PADDING", 1) == 1;
+            // GGML_SYCL_FA_XMX_WIDE21_64=1: the same 128-row tile with 64 subgroups (each half the tiles of 32)
+            static const bool w64 = ggml_sycl_get_env("GGML_SYCL_FA_XMX_WIDE21_64", 0) == 1 &&
+                                    ctx.stream()->get_device().get_info<sycl::info::device::max_work_group_size>() >= 64 * XSG;
+            if (w64) {
+                wide_attn_run<21, true, false, 64>(ctx, p);
+            } else if (trim_padding && p.ntok <= 18) {
+                wide_attn_run<21, true>(ctx, p);
+            } else {
+                wide_attn_run<21>(ctx, p);
+            }
+        } else if (stream && fits && p.ntok >= 22 && p.ntok <= 32) {
+            wide_attn_run<32>(ctx, p);
+        } else if (stream && fits && p.ntok >= 33 && p.ntok <= 48) {
+            wide_attn_run<48>(ctx, p);
+        } else {
+            xmx_attn_run<16, 32>(ctx, p);
+        }
+    }
+    return true;
+}
