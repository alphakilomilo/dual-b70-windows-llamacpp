+            ggml_tensor * a   = ggml_mul(ctx0, head_rows, model.output_norm);                            // [H, k, n_pos, nb]
+            ggml_tensor * ax  = ggml_mul_mat(ctx0, a, raw_run);                                           // [k, 1, n_pos, nb]
+            ggml_tensor * aw  = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, model.dspine_write_t,
+                    ggml_reshape_2d(ctx0, a, n_embd, top_k * n_pos * n_blocks)), rank, top_k, n_pos, n_blocks);
+            ggml_tensor * num = ggml_add(ctx0, ggml_mul(ctx0, ggml_mul_mat(ctx0, aw, m), rms_run), ax);
+
+            ggml_tensor * xx  = ggml_sum_rows(ctx0, ggml_sqr(ctx0, raw_run));                             // [1, 1, n_pos, nb]
+            ggml_tensor * wx  = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, model.dspine_write_t,
+                    ggml_reshape_2d(ctx0, raw_run, n_embd, n_pos * n_blocks)), rank, 1, n_pos, n_blocks);
+            ggml_tensor * mwx = ggml_mul_mat(ctx0, wx, m);                                                // [1, P, n_pos, nb]
+            ggml_tensor * gm  = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, model.dspine_write_gram,
+                    ggml_reshape_2d(ctx0, m, rank, n_m)), rank, n_pred, n_pos, n_blocks);
+            ggml_tensor * mgm = ggml_sum_rows(ctx0, ggml_mul(ctx0, gm, m));                               // [1, P, n_pos, nb]
+            ggml_tensor * yy  = ggml_add(ctx0, ggml_add(ctx0,
+                    ggml_mul(ctx0, ggml_scale(ctx0, mwx, 2.0f), rms_run),
