+++ b/common/lookup-policy.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+// Per-sequence progress observations. Lookup excludes shortened draft budgets.
+struct lookup_policy {
+    struct window {
+        std::array<uint16_t, 8> values{};
+        unsigned count = 0, pos = 0, sum = 0;
+        void add(uint16_t value) {
+            sum -= values[pos];
+            values[pos] = value;
+            sum += value;
+            pos = (pos + 1) % values.size();
+            if (count < values.size()) ++count;
+        }
+    } lookup, dflash;
+    uint64_t matches = 0, skipped = 0, selected = 0, accepted = 0;
+    unsigned pending = 0;
+
+    bool allow(bool enabled) {
+        ++matches;
+        if (!enabled || lookup.count < 4 || dflash.count < 4) return true;
+        // Require a substantial progress deficit to cover lookup's cheaper draft cost.
+        const uint64_t lhs = uint64_t(lookup.sum + lookup.count) * dflash.count * 6;
+        const uint64_t rhs = uint64_t(dflash.sum + dflash.count) * lookup.count * 5;
+        if (lhs >= rhs || matches % 4 == 0) return true;
+        ++skipped;
+        return false;
+    }
+};
