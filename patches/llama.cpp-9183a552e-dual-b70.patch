@@ -0,0 +1,51 @@
+"""Validate the supported independent-write DSpine checkpoint contract."""
+import math
+
+
+def validate_dspine(hparams):
+    dc = hparams.get("dflash_config", {})
+    bridge = dc.get("selected_prefix_code_bridge")
+    if bridge is None:
+        return None
+    layers = int(hparams["num_hidden_layers"])
+    active = dc.get("selected_prefix_feature_layers", [])
+    if (not active or len(set(active)) != len(active)
+            or any(type(i) is not int or not 1 <= i <= layers for i in active)
+            or layers not in active):
+        raise ValueError("DSpine requires valid active layers including the last layer")
+    if (dc.get("selected_prefix_terminal", True)
+            or dc.get("selected_prefix_feature_write_mode") != "independent"
+            or dc.get("selected_prefix_feature_writes") is not True
+            or dc.get("draft_block_causal") is not True
+            or dc.get("selected_prefix_feature_next_token_rows", False)
+            or dc.get("selected_prefix_feature_reliability") is not None
+            or dc.get("selected_prefix_terminal_residual_rank", 0) != 0):
+        raise ValueError("Unsupported DSpine bridge configuration")
+    if hparams.get("is_causal", True) is not True:
+        raise ValueError("DSpine requires causal draft attention")
+    if (int(bridge["code_size"]) <= 0 or int(bridge["rank"]) <= 0
+            or not math.isfinite(float(bridge["eps"])) or float(bridge["eps"]) <= 0
+            or int(hparams["block_size"]) < 2):
+        raise ValueError("Invalid DSpine dimensions or epsilon")
+    widths = []
+    second = hparams.get("code_bridge_second_pass")
+    if second is not None:
+        if (set(second) - {"mode", "first_exact", "head_topk"}
+                or second.get("mode") != "serial_table"
+                or second.get("first_exact") != layers - 1):
+            raise ValueError("DSpine only supports last-write serial refinement")
+        widths.append(int(second["head_topk"]))
+    refine = dc.get("selected_prefix_last_write_refine")
+    if refine is not None:
+        if (set(refine) - {"kind", "version", "head_topk", "weight"}
+                or refine.get("kind") != "exact_sender" or refine.get("version", 1) != 1
+                or not math.isfinite(float(refine.get("weight", 1)))
+                or float(refine.get("weight", 1)) < 0):
+            raise ValueError("Unsupported DSpine refinement")
+        widths.append(int(refine["head_topk"]))
+    if not widths or len(set(widths)) != 1:
+        raise ValueError("Missing or conflicting DSpine refinement widths")
+    k = widths[0]
+    if k < 2 or k > 64 or k & (k - 1) or k * (k + 2) > int(hparams["hidden_size"]):
+        raise ValueError("DSpine refinement width exceeds the lattice contract")
+    return k
