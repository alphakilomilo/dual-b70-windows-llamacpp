+// rms_norm_f32 with the same block size, so the result is bit-identical to the three ops run separately.
+bool ggml_sycl_op_add_rms_norm_mul_fused(ggml_backend_sycl_context & ctx, ggml_tensor * add, ggml_tensor * rms, ggml_tensor * mul) {
+    const ggml_tensor * a = add->src[0];
+    const ggml_tensor * b = add->src[1];
+    const ggml_tensor * w = mul->src[0] == rms ? mul->src[1] : mul->src[0];
+    if (a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 || rms->type != GGML_TYPE_F32 ||
+        mul->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_are_same_shape(a, b) || !ggml_are_same_shape(a, add) || !ggml_are_same_shape(add, mul) ||
+        !ggml_is_contiguous(a) || !ggml_is_contiguous(b) || !ggml_is_contiguous(add) || !ggml_is_contiguous(rms) ||
+        !ggml_is_contiguous(mul) || !ggml_is_contiguous(w) || w->ne[0] != add->ne[0] || ggml_nrows(w) != 1) {
+        return false;
+    }
+    float eps = 0.0f;
+    memcpy(&eps, rms->op_params, sizeof(float));
+
+    const int     ncols = add->ne[0];
+    const int64_t nrows = ggml_nrows(add);
+    const float * ad = (const float *) a->data;
+    const float * bd = (const float *) b->data;
+    const float * wd = (const float *) w->data;
+    float *       sd = (float *) add->data;
+    float *       od = (float *) mul->data;
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    const int block_size = ncols < 1024 ? WARP_SIZE : ggml_sycl_info().max_work_group_sizes[ctx.device];
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> s_sum(sycl::range<1>(std::max(1, block_size / WARP_SIZE)), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>(nrows * block_size), sycl::range<1>(block_size)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int64_t row = it.get_group(0);
+                const int     tid = it.get_local_id(0);
+                const float * x0  = ad + row * ncols;
+                const float * x1  = bd + row * ncols;
+                float *       s   = sd + row * ncols;
+                float *       o   = od + row * ncols;
+                float tmp = 0.0f;
+                for (int col = tid; col < ncols; col += block_size) {
+                    const float xi = x0[col] + x1[col];
+                    s[col] = xi;
+                    tmp += xi * xi;
+                }
+                auto sg = it.get_sub_group();
+                for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                    tmp += dpct::permute_sub_group_by_xor(sg, tmp, mask);
+                }
+                if (block_size > WARP_SIZE) {
+                    const int sg_id = sg.get_group_linear_id();
+                    const int lane  = sg.get_local_linear_id();
+                    if (lane == 0) {
+                        s_sum[sg_id] = tmp;
+                    }
+                    it.barrier(sycl::access::fence_space::local_space);
+                    const int nwarps  = block_size / WARP_SIZE;
+                    const int nreduce = (nwarps + WARP_SIZE - 1) / WARP_SIZE;
+                    tmp = 0.0f;
+                    for (int i = 0; i < nreduce; i += 1) {
+                        tmp += s_sum[lane + i * WARP_SIZE];
+                    }
+                    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                    tmp += dpct::permute_sub_group_by_xor(sg, tmp, mask);
+                }
+                }
+                const float scale = sycl::rsqrt(tmp / ncols + eps);
+                for (int col = tid; col < ncols; col += block_size) {
+                    o[col] = scale * s[col] * wd[col];
+                }
+            });
+    });
+    return true;
+}
