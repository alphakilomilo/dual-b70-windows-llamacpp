+// XMX split-K flash attention for speculative verify on Intel Xe2 (Arc Pro B70).
+//
+// Scope: D = 256, Q heads per KV head = 6, 1..64 query tokens, one sequence, F16 K/V (cache views), F16 mask,
+// no sinks / ALiBi / softcap, n_kv a multiple of 128. All query rows of a KV head (tokens x 6 heads) go through the
+// matrix units together, so every K/V byte of a tile is read once for all of them:
+//   S^T = K * Q^T   A = K tile (8 keys x 16 dims, from the cache), B = Q^T (SLM, pre-scaled f16)
+//   O  += P * V     A = P (SLM f16, online softmax), B = V tile (16 keys x 16 dims, from the cache)
+// A work-group handles one KV head x one contiguous chunk of keys x one chunk of query tokens; a second kernel
+// merges the key chunks. Two configurations (same code, template parameters), both with 128-key tiles and the
+// same per-subgroup work (3 S^T tiles, 3 softmax rows, 6 output accumulators):
+//   1..8 tokens:  8-token chunks, 16 subgroups (the decode / 7-draft verify path)
+//   9..64 tokens: 16-token chunks, 32 subgroups: K/V is read once per 16 tokens (the two subgroups sharing a K
+//                 block load it together, L1 hit), SLM Q^T 48 KB + scores 48 KB + P 24 KB of 128 KB. More than 16
+//                 tokens run as adjacent chunks, so a later chunk's K/V reads mostly hit L2.
+// (A 16-token x 64-key tile with the large register file was slower: half the occupancy, duplicate K loads.)
+// The TILE kernel this replaces grouped heads in pairs for gqa 6 (K/V read three times) and ran the dot products
+// on the vector units; measured per GPU at 131K keys, 8 tokens: 1.82 ms -> 0.77 ms (standalone prototype).
+
+#include <sycl/sycl.hpp>
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+#include "fattn-xmx.hpp"
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+namespace {
+
+namespace mx  = sycl::ext::oneapi::experimental::matrix;
+namespace mxi = sycl::ext::intel::experimental::matrix;
+using half    = sycl::half;
+
+constexpr int XD   = 256;        // head size
+constexpr int XG   = 6;          // query heads per KV head
+constexpr int XMAXTOK = 64;      // max query tokens
+constexpr int XSG  = 16;         // subgroup size
+constexpr int XKT  = 128;        // keys per tile
+constexpr int XTM = 8, XTN = 16, XTK = 16;
+constexpr int XDS  = XD / XTN;   // 16-dim output slices
+
+struct xmx_params {
+    const char * Q;  int64_t q_tok, q_head;   // byte strides, f32 data
+    const half * K;  int64_t k_key, k_head;   // element strides
+    const half * V;  int64_t v_key, v_head;
+    const half * mask; int64_t m_tok;         // element stride
+    int   ntok, n_kv, hkv, nsplit, tiles_per, nchunk;
+    float scale;
+    float * opart;   // [hkv*nsplit*nchunk][R][XD]
+    float * meta;    // [hkv*nsplit*nchunk][R][2]
+    float * dst;     // [t][hq][XD]
+};
+
+// NT query tokens per chunk, NSG subgroups per work-group
+template <int NT, int NSG>
+struct xmx_cfg {
+    static constexpr int R   = NT * XG;          // query rows per KV head and chunk
+    static constexpr int KB  = XKT / XTM;        // 8-key blocks per tile (S^T row blocks)
+    static constexpr int NG  = NSG / KB;         // subgroups sharing one key block (split the S^T columns)
+    static constexpr int NPS = (R / XTN) / NG;   // S^T column tiles per subgroup
+    static constexpr int RG  = NSG / XDS;        // subgroups sharing one output dim slice (split the rows)
+    static constexpr int RPS = R / RG;           // output rows per subgroup
+    static_assert(NSG % KB == 0 && (R / XTN) % NG == 0, "S^T tiles split evenly");
+    static_assert(NSG % XDS == 0 && RPS % XTM == 0, "output tiles split evenly");
+    static_assert(R % NSG == 0, "softmax rows split evenly");
+};
+
+template <int NT, int NSG, bool RegisterStats = false>
+struct xmx_attn_kernel {
+    using C = xmx_cfg<NT, NSG>;
+    sycl::local_accessor<half, 1>  QT;
+    sycl::local_accessor<float, 1> ST;
+    sycl::local_accessor<half, 1>  P;
+    sycl::local_accessor<float, 1> stat;
+    xmx_params pp;
+
+    [[sycl::reqd_sub_group_size(XSG)]] void operator()(sycl::nd_item<1> it) const {
+        constexpr int R = C::R;
+        const auto sg   = it.get_sub_group();
+        const int  sgid = sg.get_group_id()[0];
+        const int  lane = sg.get_local_id()[0];
+        const int  g    = it.get_group(0);
+        // g = (kvh * nsplit + sp) * nchunk + ch: query chunks of one K/V range are neighbours (L2 reuse)
+        const int  ch   = g % pp.nchunk;
+        const int  kvh  = g / pp.nchunk / pp.nsplit;
+        const int  sp   = g / pp.nchunk % pp.nsplit;
+        const int  lid  = it.get_local_id(0);
+        const int  t0   = ch * NT;                                   // first query token of this chunk
+        const int  ntok = sycl::min(NT, pp.ntok - t0);               // query tokens in this chunk
+
+        float * m_s  = &stat[0];
+        float * l_s  = RegisterStats ? nullptr : &stat[R];
+        float * rs_s = &stat[RegisterStats ? 0 : 2 * R];
+        float running_max[R / NSG];
+        float running_sum[R / NSG];
+        if constexpr (RegisterStats) {
+#pragma unroll
+            for (int rr = 0; rr < R / NSG; ++rr) {
+                running_max[rr] = -3.0e38f;
+                running_sum[rr] = 0.0f;
+            }
+        }
+
+        for (int idx = lid; idx < R * XD; idx += NSG * XSG) {
+            const int r = idx / XD, d = idx % XD, t = r / XG, hl = r % XG;
+            float v = 0.0f;
+            if (t < ntok) {
+                v = ((const float *) (pp.Q + (t0 + t) * pp.q_tok + (kvh * XG + hl) * pp.q_head))[d] * pp.scale;
+            }
+            QT[d * R + r] = (half) v;
+        }
+        if constexpr (!RegisterStats) {
+            for (int r = lid; r < R; r += NSG * XSG) { m_s[r] = -3.0e38f; l_s[r] = 0.0f; rs_s[r] = 1.0f; }
+        }
+        sycl::group_barrier(it.get_group());
+
+        // output tiling: this subgroup owns dim slice ds (16 dims) x rows [r0, r0 + RPS)
+        const int ds = sgid % XDS;
+        const int r0 = (sgid / XDS) * C::RPS;
+        mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, XTM, XTN> acc[C::RPS / XTM];
+#pragma unroll
+        for (int mi = 0; mi < C::RPS / XTM; ++mi) mx::joint_matrix_fill(sg, acc[mi], 0.0f);
+
+        const auto Kg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+            pp.K + (size_t) kvh * pp.k_head);
+        const auto Vg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+            pp.V + (size_t) kvh * pp.v_head);
+        auto QTp = QT.template get_multi_ptr<sycl::access::decorated::no>();
+        auto STp = ST.template get_multi_ptr<sycl::access::decorated::no>();
+        auto Pp  = P.template get_multi_ptr<sycl::access::decorated::no>();
+
+        // S^T tiling: this subgroup computes key block kb (8 keys) x column tiles [n0, n0 + NPS)
+        const int kb = sgid % C::KB;
+        const int n0 = (sgid / C::KB) * C::NPS;
+
+        const int tile0 = sp * pp.tiles_per;
+        const int tile1 = sycl::min(tile0 + pp.tiles_per, pp.n_kv / XKT);
+        for (int tile = tile0; tile < tile1; ++tile) {
+            const int k0 = tile * XKT;
+
+            mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, XTM, XTN> s[C::NPS];
+#pragma unroll
+            for (int n = 0; n < C::NPS; ++n) mx::joint_matrix_fill(sg, s[n], 0.0f);
+#pragma unroll 4
+            for (int kd = 0; kd < XD; kd += XTK) {
+                mx::joint_matrix<sycl::sub_group, half, mx::use::a, XTM, XTK, mx::layout::row_major> a;
+                mx::joint_matrix_load(sg, a, Kg + (size_t) (k0 + kb * XTM) * pp.k_key + kd, pp.k_key);
+#pragma unroll
+                for (int n = 0; n < C::NPS; ++n) {
+                    mx::joint_matrix<sycl::sub_group, half, mx::use::b, XTK, XTN, mx::layout::row_major> b;
+                    mx::joint_matrix_load(sg, b, QTp + kd * R + (n0 + n) * XTN, R);
+                    mx::joint_matrix_mad(sg, s[n], a, b, s[n]);
+                }
+            }
+#pragma unroll
+            for (int n = 0; n < C::NPS; ++n) {
+                mx::joint_matrix_store(sg, s[n], STp + (kb * XTM) * R + (n0 + n) * XTN, R, mx::layout::row_major);
+            }
+            sycl::group_barrier(it.get_group());
+
+            for (int rr = 0; rr < R / NSG; ++rr) {
+                const int r = sgid * (R / NSG) + rr;
+                const int t = r / XG;
+                if (t >= ntok) {
+                    for (int k = lane; k < XKT; k += XSG) P[r * XKT + k] = (half) 0.0f;
+                    if (lane == 0) rs_s[r] = 1.0f;
+                    continue;
+                }
+                float sv[XKT / XSG];
+                float mloc = -3.0e38f;
+#pragma unroll
+                for (int i = 0; i < XKT / XSG; ++i) {
+                    const int k = lane + i * XSG;
+                    sv[i] = ST[k * R + r] + (float) pp.mask[(t0 + t) * pp.m_tok + k0 + k];
+                    mloc  = sycl::fmax(mloc, sv[i]);
+                }
+                const float m_old = RegisterStats ? running_max[rr] : m_s[r];
+                const float m_new = sycl::fmax(m_old, sycl::reduce_over_group(sg, mloc, sycl::maximum<float>()));
+                float sum = 0.0f;
+#pragma unroll
+                for (int i = 0; i < XKT / XSG; ++i) {
+                    const float pv = sycl::native::exp(sv[i] - m_new);
+                    sum += pv;
+                    P[r * XKT + lane + i * XSG] = (half) pv;
+                }
+                sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+                if (lane == 0) {
+                    const float sc = sycl::native::exp(m_old - m_new);
+                    rs_s[r] = sc;
+                    if constexpr (RegisterStats) {
+                        running_sum[rr] = running_sum[rr] * sc + sum;
+                    } else {
+                        l_s[r] = l_s[r] * sc + sum;
+                        m_s[r] = m_new;
+                    }
+                }
+                if constexpr (RegisterStats) running_max[rr] = m_new;
+            }
+            sycl::group_barrier(it.get_group());
+
+#pragma unroll
+            for (int mi = 0; mi < C::RPS / XTM; ++mi) {
+                mxi::joint_matrix_apply(sg, acc[mi], [=](float & x, size_t row, size_t) { x *= rs_s[r0 + mi * XTM + row]; });
+            }
+#pragma unroll
+            for (int kk = 0; kk < XKT; kk += XTK) {
+                mx::joint_matrix<sycl::sub_group, half, mx::use::b, XTK, XTN, mx::layout::row_major> b;
+                mx::joint_matrix_load(sg, b, Vg + (size_t) (k0 + kk) * pp.v_key + ds * XTN, pp.v_key);
+#pragma unroll
+                for (int mi = 0; mi < C::RPS / XTM; ++mi) {
+                    mx::joint_matrix<sycl::sub_group, half, mx::use::a, XTM, XTK, mx::layout::row_major> a;
+                    mx::joint_matrix_load(sg, a, Pp + (r0 + mi * XTM) * XKT + kk, XKT);
+                    mx::joint_matrix_mad(sg, acc[mi], a, b, acc[mi]);
+                }
+            }
+            sycl::group_barrier(it.get_group());
+        }
+
+        const auto Og = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+            pp.opart + (size_t) g * R * XD);
+#pragma unroll
+        for (int mi = 0; mi < C::RPS / XTM; ++mi) {
+            mx::joint_matrix_store(sg, acc[mi], Og + (r0 + mi * XTM) * XD + ds * XTN, XD, mx::layout::row_major);
+        }
+        if constexpr (RegisterStats) {
+            if (lane == 0) {
+                for (int rr = 0; rr < R / NSG; ++rr) {
+                    const size_t r = (size_t) g * R + sgid * (R / NSG) + rr;
+                    pp.meta[r * 2] = running_max[rr];
+                    pp.meta[r * 2 + 1] = running_sum[rr];
+                }
+            }
+        } else {
+            for (int r = lid; r < R; r += NSG * XSG) {
+                pp.meta[((size_t) g * R + r) * 2 + 0] = m_s[r];
+                pp.meta[((size_t) g * R + r) * 2 + 1] = l_s[r];
+            }
+        }
+    }
+};
+
+template <int NT, int NSG, bool RegisterStats = false>
+void xmx_attn_launch(sycl::queue & q, const xmx_params & p) {
+    constexpr int R = xmx_cfg<NT, NSG>::R;
+    q.submit([&](sycl::handler & h) {
+        xmx_attn_kernel<NT, NSG, RegisterStats> k{
+            sycl::local_accessor<half, 1>(XD * R, h),
+            sycl::local_accessor<float, 1>(XKT * R, h),
+            sycl::local_accessor<half, 1>(R * XKT, h),
+            sycl::local_accessor<float, 1>((RegisterStats ? 1 : 3) * R, h),
+            p,
+        };
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) p.hkv * p.nsplit * p.nchunk * NSG * XSG),
+                                         sycl::range<1>(NSG * XSG)), k);
+    });
+
+    const xmx_params pp = p;
+    q.parallel_for(sycl::range<3>(p.ntok, p.hkv * XG, XD), [=](sycl::id<3> id) {
+        const int t = id[0], h = id[1], d = id[2];
+        const int ch = t / NT;
+        const int kvh = h / XG, r = (t % NT) * XG + h % XG;
+        float M = -3.0e38f;
+        for (int s = 0; s < pp.nsplit; ++s) {
+            M = sycl::fmax(M, pp.meta[((size_t) ((kvh * pp.nsplit + s) * pp.nchunk + ch) * R + r) * 2]);
+        }
+        float num = 0.0f, den = 0.0f;
+        for (int s = 0; s < pp.nsplit; ++s) {
+            const size_t gs = ((size_t) kvh * pp.nsplit + s) * pp.nchunk + ch;
+            const float  w  = sycl::native::exp(pp.meta[(gs * R + r) * 2] - M);
+            num += w * pp.opart[(gs * R + r) * XD + d];
+            den += w * pp.meta[(gs * R + r) * 2 + 1];
+        }
+        pp.dst[((size_t) t * pp.hkv * XG + h) * XD + d] = den > 0.0f ? num / den : 0.0f;
+    });
+}
+
+// split the key range into up to 128 work-group chunks per KV head (and query chunk)
+template <int NT, int NSG, bool RegisterStats = false>
+void xmx_attn_run(ggml_backend_sycl_context & ctx, xmx_params & p) {
+    constexpr int R = xmx_cfg<NT, NSG>::R;
+    const int tiles = p.n_kv / XKT;
+    // Key chunks per KV head: enough work-groups to fill the 32 Xe-cores and no more, because every work-group pays a
+    // fixed cost (Q^T into SLM, a partial-output write, a merge read). Measured per GPU at 64K/131K keys: ~64
+    // work-groups for 16 subgroups (8 tokens: 0.48 -> 0.34 ms at 64K vs 128 chunks), ~32 for 32 subgroups
+    // (16 tokens: 0.80 -> 0.58 ms). GGML_SYCL_FA_XMX_NSPLIT overrides the chunk count.
+    const int nchunk_q   = (p.ntok + NT - 1) / NT;
+    const int target_wg  = NSG >= 32 ? 32 : 64;
+    static const int env_split = ggml_sycl_get_env("GGML_SYCL_FA_XMX_NSPLIT", 0);
+    const int want_split = env_split > 0 ? env_split : std::max(1, target_wg / (p.hkv * nchunk_q));
+    int nsplit = tiles < want_split ? tiles : want_split;
+    const int tiles_per = (tiles + nsplit - 1) / nsplit;
+    nsplit = (tiles + tiles_per - 1) / tiles_per;
+    const int nchunk = (p.ntok + NT - 1) / NT;
+
+    ggml_sycl_pool_alloc<float> opart(ctx.pool(), (size_t) p.hkv * nsplit * nchunk * R * XD);
+    ggml_sycl_pool_alloc<float> meta(ctx.pool(), (size_t) p.hkv * nsplit * nchunk * R * 2);
+    p.nsplit = nsplit; p.tiles_per = tiles_per; p.nchunk = nchunk;
+    p.opart = opart.get(); p.meta = meta.get();
+    xmx_attn_launch<NT, NSG, RegisterStats>(*ctx.stream(), p);
+}
+
+// Wide-query attention: queries reside in a packed GPU buffer; F32 scores and F16 probabilities stay in SLM.
+constexpr int WKT = 64;
+// NSG subgroups per work-group: rows pad to a multiple of 16 * NSG / 8 (64 rows at 32 subgroups, 96 at 48)
+template<int NT, int NSG = 32> struct wide_cfg {
+    static constexpr int KB = WKT / XTM;
+    static constexpr int NG = NSG / KB;
+    static constexpr int R = ((NT * XG + XTN * NG - 1) / (XTN * NG)) * (XTN * NG);
+    static constexpr int NPS = (R / XTN) / NG;
+    static constexpr int RPS = R / (NSG / XDS);
+    static_assert(NSG % KB == 0 && NSG % XDS == 0 && (R / XTN) % NG == 0 && R % NSG == 0 && RPS % XTM == 0,
+                  "wide tile division");
+};
+template <int NT, bool TrimPadding, bool LocalQuery, int NSG_ = 32>
+struct wide_attn_kernel {
+    using C = wide_cfg<NT, NSG_>;
+    static constexpr int NSG = NSG_;
+    sycl::local_accessor<float, 1> ST;
+    sycl::local_accessor<half, 1>  P;
+    sycl::local_accessor<float, 1> stat;
+    sycl::local_accessor<half, 1>  local_query;
+    xmx_params pp;
+    const half * packed_q;
+
+    auto get(sycl::ext::oneapi::experimental::properties_tag) const {
+        return sycl::ext::oneapi::experimental::properties{
+            sycl::ext::intel::experimental::grf_size<(NSG_ > 32 ? 128 : 256)>,
+            sycl::ext::oneapi::experimental::sub_group_size<XSG> };
+    }
+    void operator()(sycl::nd_item<1> it) const {
+        constexpr int R = C::R;
+        const auto sg   = it.get_sub_group();
+        const int  sgid = sg.get_group_id()[0];
+        const int  lane = sg.get_local_id()[0];
+        const int  g    = it.get_group(0);
+        // g = (kvh * nsplit + sp) * nchunk + ch: query chunks of one K/V range are neighbours (L2 reuse)
+        const int  ch   = g % pp.nchunk;
+        const int  kvh  = g / pp.nchunk / pp.nsplit;
+        const int  sp   = g / pp.nchunk % pp.nsplit;
+        const int  lid  = it.get_local_id(0);
+        const int  t0   = ch * NT;                                   // first query token of this chunk
+        const int  ntok = sycl::min(NT, pp.ntok - t0);               // query tokens in this chunk
+        // All work-item lanes in a subgroup take the same matrix-tile branch.
+        const int  live_rows = TrimPadding ? ntok * XG : R;
+
+        float * m_s  = &stat[0];
+        float * l_s  = &stat[R];
+        float * rs_s = &stat[2 * R];
+
+        for (int r = lid; r < R; r += NSG * XSG) { m_s[r] = -3.0e38f; l_s[r] = 0.0f; rs_s[r] = 1.0f; }
+        if constexpr (LocalQuery) {
+            for (int i = lid; i < XD * R; i += NSG * XSG) {
+                const int r = i % R;
+                const int token = r / XG;
+                float value = 0.0f;
+                if (token < ntok) {
+                    const auto * q = (const float *) (pp.Q + (t0 + token) * pp.q_tok + (kvh * XG + r % XG) * pp.q_head);
+                    value = q[i / R] * pp.scale;
+                }
+                local_query[i] = (half) value;
+            }
+        }
+        sycl::group_barrier(it.get_group());
+
+        // output tiling: this subgroup owns dim slice ds (16 dims) x rows [r0, r0 + RPS)
+        const int ds = sgid % XDS;
+        const int r0 = (sgid / XDS) * C::RPS;
+        mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, XTM, XTN> acc[C::RPS / XTM];
+#pragma unroll
+        for (int mi = 0; mi < C::RPS / XTM; ++mi) mx::joint_matrix_fill(sg, acc[mi], 0.0f);
+
+        const auto Kg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+            pp.K + (size_t) kvh * pp.k_head);
+        const auto Vg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+            pp.V + (size_t) kvh * pp.v_head);
+        auto QTp = [&] {
+            if constexpr (LocalQuery) {
+                return local_query.template get_multi_ptr<sycl::access::decorated::no>();
+            } else {
+                return sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+                    packed_q + (size_t) kvh * XD * R);
+            }
+        }();
+        auto STp = ST.template get_multi_ptr<sycl::access::decorated::no>();
+        auto Pp  = P.template get_multi_ptr<sycl::access::decorated::no>();
+
+        // S^T tiling: this subgroup computes key block kb (8 keys) x column tiles [n0, n0 + NPS)
+        const int kb = sgid % C::KB;
+        const int n0 = (sgid / C::KB) * C::NPS;
+
+        const int tile0 = sp * pp.tiles_per;
+        const int tile1 = sycl::min(tile0 + pp.tiles_per, pp.n_kv / WKT);
+        for (int tile = tile0; tile < tile1; ++tile) {
+            const int k0 = tile * WKT;
+
+            mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, XTM, XTN> s[C::NPS];
+#pragma unroll
+            for (int n = 0; n < C::NPS; ++n) mx::joint_matrix_fill(sg, s[n], 0.0f);
+#pragma unroll 4
+            for (int kd = 0; kd < XD; kd += XTK) {
+                mx::joint_matrix<sycl::sub_group, half, mx::use::a, XTM, XTK, mx::layout::row_major> a;
+                mx::joint_matrix_load(sg, a, Kg + (size_t) (k0 + kb * XTM) * pp.k_key + kd, pp.k_key);
+#pragma unroll
+                for (int n = 0; n < C::NPS; ++n) {
+                    if ((n0 + n) * XTN >= live_rows) continue;
+                    mx::joint_matrix<sycl::sub_group, half, mx::use::b, XTK, XTN, mx::layout::row_major> b;
+                    mx::joint_matrix_load(sg, b, QTp + kd * R + (n0 + n) * XTN, R);
+                    mx::joint_matrix_mad(sg, s[n], a, b, s[n]);
+                }
+            }
+#pragma unroll
+            for (int n = 0; n < C::NPS; ++n) {
+                if ((n0 + n) * XTN >= live_rows) continue;
+                mx::joint_matrix_store(sg, s[n], STp + (kb * XTM) * R + (n0 + n) * XTN, R, mx::layout::row_major);
+            }
+            sycl::group_barrier(it.get_group());
+
+            for (int rr = 0; rr < R / NSG; ++rr) {
+                const int r = sgid * (R / NSG) + rr;
+                const int t = r / XG;
+                if (t >= ntok) {
+                    if (r / XTM * XTM >= live_rows) continue;
+                    for (int k = lane; k < WKT; k += XSG) P[r * WKT + k] = (half) 0.0f;
+                    if (lane == 0) rs_s[r] = 1.0f;
+                    continue;
+                }
+                float sv[WKT / XSG];
+                float mloc = -3.0e38f;
+#pragma unroll
+                for (int i = 0; i < WKT / XSG; ++i) {
+                    const int k = lane + i * XSG;
+                    sv[i] = ST[k * R + r] + (float) pp.mask[(t0 + t) * pp.m_tok + k0 + k];
+                    mloc  = sycl::fmax(mloc, sv[i]);
+                }
+                const float m_old = m_s[r];
+                const float m_new = sycl::fmax(m_old, sycl::reduce_over_group(sg, mloc, sycl::maximum<float>()));
+                float sum = 0.0f;
+#pragma unroll
+                for (int i = 0; i < WKT / XSG; ++i) {
+                    const float pv = sycl::native::exp(sv[i] - m_new);
+                    sum += pv;
+                    P[r * WKT + lane + i * XSG] = (half) pv;
+                }
+                sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+                if (lane == 0) {
+                    const float sc = sycl::native::exp(m_old - m_new);
+                    rs_s[r] = sc;
+                    l_s[r]  = l_s[r] * sc + sum;
+                    m_s[r]  = m_new;
+                }
+            }
+            sycl::group_barrier(it.get_group());
+
+#pragma unroll
+            for (int mi = 0; mi < C::RPS / XTM; ++mi) {
+                if (r0 + mi * XTM >= live_rows) continue;
+                mxi::joint_matrix_apply(sg, acc[mi], [=](float & x, size_t row, size_t) { x *= rs_s[r0 + mi * XTM + row]; });
+            }
+#pragma unroll
+            for (int kk = 0; kk < WKT; kk += XTK) {
+                mx::joint_matrix<sycl::sub_group, half, mx::use::b, XTK, XTN, mx::layout::row_major> b;
+                mx::joint_matrix_load(sg, b, Vg + (size_t) (k0 + kk) * pp.v_key + ds * XTN, pp.v_key);
+#pragma unroll
+                for (int mi = 0; mi < C::RPS / XTM; ++mi) {
+                    if (r0 + mi * XTM >= live_rows) continue;
+                    mx::joint_matrix<sycl::sub_group, half, mx::use::a, XTM, XTK, mx::layout::row_major> a;
+                    mx::joint_matrix_load(sg, a, Pp + (r0 + mi * XTM) * WKT + kk, WKT);
+                    mx::joint_matrix_mad(sg, acc[mi], a, b, acc[mi]);
+                }
+            }
+            sycl::group_barrier(it.get_group());
+        }
+
+        const auto Og = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+            pp.opart + (size_t) g * R * XD);
+#pragma unroll
+        for (int mi = 0; mi < C::RPS / XTM; ++mi) {
+            if (r0 + mi * XTM >= live_rows) continue;
+            mx::joint_matrix_store(sg, acc[mi], Og + (r0 + mi * XTM) * XD + ds * XTN, XD, mx::layout::row_major);
+        }
+        for (int r = lid; r < live_rows; r += NSG * XSG) {
+            pp.meta[((size_t) g * R + r) * 2 + 0] = m_s[r];
+            pp.meta[((size_t) g * R + r) * 2 + 1] = l_s[r];
+        }
+    }
+};
+
+template<int NT, bool TrimPadding = false, bool LocalQuery = false, int NSG = 32>
+void wide_attn_run(ggml_backend_sycl_context & ctx, xmx_params & p) {
+    constexpr int R = wide_cfg<NT, NSG>::R;
+    const int tiles = p.n_kv / WKT;
+    static const int env_split = ggml_sycl_get_env("GGML_SYCL_FA_XMX_NSPLIT", 0);
+    const int want = env_split > 0 ? env_split : std::max(1, 32 / p.hkv);
+    int nsplit = std::min(tiles, want);
+    const int tiles_per = (tiles + nsplit - 1) / nsplit;
+    nsplit = (tiles + tiles_per - 1) / tiles_per;
+    ggml_sycl_pool_alloc<half> queries(ctx.pool());
+    if constexpr (!LocalQuery) queries.alloc((size_t) p.hkv * XD * R);
+    ggml_sycl_pool_alloc<float> output(ctx.pool(), (size_t) p.hkv * nsplit * R * XD);
+    ggml_sycl_pool_alloc<float> metadata(ctx.pool(), (size_t) p.hkv * nsplit * R * 2);
+    p.nsplit=nsplit; p.tiles_per=tiles_per; p.nchunk=1;
+    p.opart=output.get(); p.meta=metadata.get();
+    half * qp = LocalQuery ? nullptr : queries.get();
+    const xmx_params pp=p;
+    auto & q=*ctx.stream();
+    if constexpr (!LocalQuery) q.parallel_for(sycl::range<1>((size_t) p.hkv * XD * R),[=](sycl::id<1> id) {
+        size_t idx=id[0];
+        int r=idx%R, d=(idx/R)%XD, kvh=idx/(R*XD), t=r/XG, hl=r%XG;
+        float value=0;
+        if(t<pp.ntok) value=((const float *)(pp.Q+t*pp.q_tok+(kvh*XG+hl)*pp.q_head))[d]*pp.scale;
+        qp[idx]=(half)value;
+    });
+    q.submit([&](sycl::handler & h) {
+        wide_attn_kernel<NT, TrimPadding, LocalQuery, NSG> k{
+            sycl::local_accessor<float,1>(WKT*R,h),
+            sycl::local_accessor<half,1>(R*WKT,h),
+            sycl::local_accessor<float,1>(3*R,h),
+            sycl::local_accessor<half,1>(LocalQuery ? XD * R : 1,h),pp,qp};
+        h.parallel_for(sycl::nd_range<1>((size_t) p.hkv * nsplit * NSG * XSG,NSG*XSG),k);
+    });
+    static const bool merge4 = NT == 10 && ggml_sycl_get_env("GGML_SYCL_FA_XMX_MERGE4", 0) == 1;
+    if (merge4) {
+        q.parallel_for(sycl::range<3>(p.ntok, p.hkv * XG, XD / 4), [=](sycl::id<3> id) {
+            const int t = id[0], head = id[1], d = id[2] * 4;
+            const size_t first = (size_t) (head / XG) * pp.nsplit * R + t * XG + head % XG;
+            float maximum = -3.0e38f;
+            for (int s = 0; s < pp.nsplit; ++s) {
+                maximum = sycl::fmax(maximum, pp.meta[(first + (size_t) s * R) * 2]);
+            }
+            float numerator[4] = {};
+            float denominator = 0.0f;
+            for (int s = 0; s < pp.nsplit; ++s) {
+                const size_t row = first + (size_t) s * R;
+                const float weight = sycl::native::exp(pp.meta[row * 2] - maximum);
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    numerator[i] += weight * pp.opart[row * XD + d + i];
+                }
+                denominator += weight * pp.meta[row * 2 + 1];
+            }
+            const size_t offset = ((size_t) t * pp.hkv * XG + head) * XD + d;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                pp.dst[offset + i] = denominator > 0.0f ? numerator[i] / denominator : 0.0f;
+            }
+        });
+        return;
+    }
+    q.parallel_for(sycl::range<3>(p.ntok,p.hkv*XG,XD),[=](sycl::id<3> id) {
+        int t=id[0],h=id[1],d=id[2],kvh=h/XG,r=t*XG+h%XG;
+        float maxval=-3.0e38f;
+        for(int s=0;s<pp.nsplit;++s) maxval=sycl::fmax(maxval,pp.meta[((size_t)(kvh*pp.nsplit+s)*R+r)*2]);
+        float num=0,den=0;
+        for(int s=0;s<pp.nsplit;++s) {
+            size_t g=(size_t)kvh*pp.nsplit+s;
+            float weight=sycl::native::exp(pp.meta[(g*R+r)*2]-maxval);
+            num+=weight*pp.opart[(g*R+r)*XD+d]; den+=weight*pp.meta[(g*R+r)*2+1];
+        }
+        pp.dst[((size_t)t*pp.hkv*XG+h)*XD+d]=den>0?num/den:0;
+    });
+}
