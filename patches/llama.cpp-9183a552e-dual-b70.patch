+
+        ggml_tensor * gate  = ggml_sigmoid(ctx0, ggml_add(ctx0, ggml_add(ctx0, pg, q_run), model.dspine_gate_b));
+        ggml_tensor * m     = ggml_mul(ctx0, gate, val);                                                  // [rank, P, n_pos, nb]
+
+        ggml_tensor * cand_run  = ggml_cont(ctx0, dspine_rows(ctx0, cand_blk,  beg, n_pos));              // [k, n_pos, nb]
+        ggml_tensor * unary_run = ggml_cont(ctx0, dspine_rows(ctx0, unary_blk, beg, n_pos));
+        ggml_tensor * head_rows = ggml_reshape_4d(ctx0,
+                ggml_get_rows(ctx0, head, ggml_reshape_1d(ctx0, cand_run, top_k * n_pos * n_blocks)),
+                n_embd, top_k, n_pos, n_blocks);
