@@ -0,0 +1,345 @@
+// Integer-DPAS GEMV for reordered Q8_0 weights x 2..8 tokens on Intel Xe2 (Arc Pro B70), and with
+// GGML_SYCL_Q8_DPAS_WIDE for 9..48 tokens (look-up draft verifies), where the 16-column activation tile repeats NT times
+// per weight tile so the weights are still read once.
+//
+//   A = weights, 8 rows x 32 int8 = one Q8_0 block per row, loaded straight from the reordered layout
+//       (row-major qs for all blocks, then the fp16 scales: see block_q_t<GGML_TYPE_Q8_0>)
+//   B = activations quantized per 32-block to int8 (d = amax/127, like q8_1) in the packed VNNI-4 layout
+//       [K/4][16 NT][4]; tokens fill columns 0..ntok-1, the rest are zero
+//   C = 8 x 16 int32 per block, scaled by d_w[row][blk] * d_a[blk][tok] into per-lane float accumulators
+// A work-group (KSPLIT sub-groups) owns an 8-row tile and splits K; partial sums are reduced in SLM.
+// Standalone measurement (experimental/int8-dpas-2026-10-22), 8 tokens, per GPU: 8704x5120 85 vs 117 us,
+// 5120x8704 87 vs 119 us, 248320x5120 2314 vs 2967 us -- about 550-600 GB/s, where the dp4a kernel reached ~400.
+
+#include <sycl/sycl.hpp>
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+#include "mmvq-dpas.hpp"
+
+namespace {
+
+namespace mx  = sycl::ext::oneapi::experimental::matrix;
+namespace mxi = sycl::ext::intel::experimental::matrix;
+using half    = sycl::half;
+
+constexpr int DP_TM = 8, DP_TN = 16, DP_TK = 32;
+constexpr int DP_SG = 16;
+
+// x: ntok rows of K floats (row stride sx floats) -> bp [K/4][nc][4] int8, da [K/32][nc] float, nc = 16 NT columns
+void dpas_quantize(sycl::queue & q, const float * x, int64_t sx, int ntok, int K, int8_t * bp, float * da, int nc = DP_TN) {
+    const int bpr = K / DP_TK;
+    q.parallel_for(sycl::range<2>((size_t) bpr, (size_t) nc), [=](sycl::id<2> id) {
+        const int b = (int) id[0], n = (int) id[1];
+        float d = 0.0f;
+        float v[DP_TK];
+        if (n < ntok) {
+            float amax = 0.0f;
+#pragma unroll
+            for (int k = 0; k < DP_TK; ++k) {
+                v[k] = x[(size_t) n * sx + (size_t) b * DP_TK + k];
+                amax = sycl::fmax(amax, sycl::fabs(v[k]));
+            }
+            d = amax / 127.0f;
+        }
+        const float id_ = d > 0.0f ? 1.0f / d : 0.0f;
+#pragma unroll
+        for (int k = 0; k < DP_TK; ++k) {
+            const int kk = b * DP_TK + k;
+            const int8_t qv = n < ntok ? (int8_t) sycl::round(v[k] * id_) : (int8_t) 0;
+            bp[((size_t) (kk / 4) * nc + n) * 4 + kk % 4] = qv;
+        }
+        da[(size_t) b * nc + n] = d;
+    });
+}
+
+template <int KSPLIT, int UNR, int NT = 1>
+void dpas_gemv(sycl::queue & q, const int8_t * qs, const half * dw, const int8_t * bp, const float * da,
+               float * out, int64_t s_out, int M, int K, int ntok) {
+    constexpr int NC = DP_TN * NT;  // activation columns: NT tiles of 16
+    const int bpr = K / DP_TK;
+    q.submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> red(KSPLIT * DP_TM * NC, h);
+        h.parallel_for(sycl::nd_range<1>((size_t) (M / DP_TM) * KSPLIT * DP_SG, KSPLIT * DP_SG),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(DP_SG)]] {
+            const auto sg   = it.get_sub_group();
+            const int  s    = sg.get_group_id()[0];
+            const int  row0 = it.get_group(0) * DP_TM;
+            const int  b0   = s * bpr / KSPLIT, b1 = (s + 1) * bpr / KSPLIT;
+            const auto qg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qs);
+            const auto bg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(bp);
+
+            float facc[NT][DP_TM * DP_TN / DP_SG] = {};
+            // one weight tile, NT activation tiles
+            auto step = [&](int bb, auto & c) {
+                mx::joint_matrix<sycl::sub_group, int8_t, mx::use::a, DP_TM, DP_TK, mx::layout::row_major> a;
+                mx::joint_matrix_load(sg, a, qg + (size_t) row0 * K + (size_t) bb * DP_TK, K);
+#pragma unroll
+                for (int t = 0; t < NT; ++t) {
+                    mx::joint_matrix<sycl::sub_group, int8_t, mx::use::b, DP_TK, DP_TN, mx::layout::ext_intel_packed> bm;
+                    mx::joint_matrix_load(sg, bm, bg + (size_t) bb * DP_TK * NC + (size_t) t * DP_TN * 4, NC * 4);
+                    mx::joint_matrix_fill(sg, c[t], 0);
+                    mx::joint_matrix_mad(sg, c[t], a, bm, c[t]);
+                }
+            };
+            auto accum = [&](int bb, auto & c) {
+#pragma unroll
+                for (int t = 0; t < NT; ++t) {
+                    int e = 0;
+                    const float * dab = da + (size_t) bb * NC + t * DP_TN;
+                    mxi::joint_matrix_apply(sg, c[t], [&](int32_t & x, size_t r, size_t col) {
+                        facc[t][e++] += (float) x * (float) dw[(size_t) (row0 + r) * bpr + bb] * dab[col];
+                    });
+                }
+            };
+            int b = b0;
+            for (; b + UNR <= b1; b += UNR) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> c[UNR][NT];
+#pragma unroll
+                for (int u = 0; u < UNR; ++u) step(b + u, c[u]);
+#pragma unroll
+                for (int u = 0; u < UNR; ++u) accum(b + u, c[u]);
+            }
+            for (; b < b1; ++b) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> c[NT];
+                step(b, c);
+                accum(b, c);
+            }
+
+            mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> coords;
+            mx::joint_matrix_fill(sg, coords, 0);
+#pragma unroll
+            for (int t = 0; t < NT; ++t) {
+                int e = 0;
+                mxi::joint_matrix_apply(sg, coords, [&](int32_t &, size_t r, size_t col) {
+                    red[(s * DP_TM + r) * NC + t * DP_TN + col] = facc[t][e++];
+                });
+            }
+            sycl::group_barrier(it.get_group());
+            for (int idx = it.get_local_id(0); idx < DP_TM * NC; idx += KSPLIT * DP_SG) {
+                const int r = idx / NC, col = idx % NC;
+                if (col < ntok) {
+                    float v = 0.0f;
+#pragma unroll
+                    for (int k = 0; k < KSPLIT; ++k) v += red[(k * DP_TM + r) * NC + col];
+                    out[(size_t) col * s_out + row0 + r] = v;
+                }
+            }
+        });
+    });
+}
+
+// Fused up/gate: one shared activation tile per block, two weight tiles, two DPAS; the reduction writes
+// silu(gate) * up straight to out (ggml SwiGLU, not swapped), so no pair buffer or separate GLU kernel.
+template <int KSPLIT, int UNR, int NT = 1>
+void dpas_glu_swiglu(sycl::queue & q, const int8_t * qu, const half * du, const int8_t * qgate, const half * dg,
+                     const int8_t * bp, const float * da, float * out, int64_t s_out, int M, int K, int ntok) {
+    constexpr int NC = DP_TN * NT;  // activation columns: NT tiles of 16
+    const int bpr = K / DP_TK;
+    q.submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> red(2 * KSPLIT * DP_TM * NC, h);
+        h.parallel_for(sycl::nd_range<1>((size_t) (M / DP_TM) * KSPLIT * DP_SG, KSPLIT * DP_SG),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(DP_SG)]] {
+            const auto sg   = it.get_sub_group();
+            const int  s    = sg.get_group_id()[0];
+            const int  row0 = it.get_group(0) * DP_TM;
+            const int  b0   = s * bpr / KSPLIT, b1 = (s + 1) * bpr / KSPLIT;
+            const auto ug = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qu);
+            const auto gg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qgate);
+            const auto bg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(bp);
+
+            float fu[NT][DP_TM * DP_TN / DP_SG] = {};
+            float fg[NT][DP_TM * DP_TN / DP_SG] = {};
+            // two weight tiles (up, gate), NT shared activation tiles
+            auto step = [&](int bb, auto & cu, auto & cg) {
+                mx::joint_matrix<sycl::sub_group, int8_t, mx::use::a, DP_TM, DP_TK, mx::layout::row_major> au, ag;
+                mx::joint_matrix_load(sg, au, ug + (size_t) row0 * K + (size_t) bb * DP_TK, K);
+                mx::joint_matrix_load(sg, ag, gg + (size_t) row0 * K + (size_t) bb * DP_TK, K);
+#pragma unroll
+                for (int t = 0; t < NT; ++t) {
+                    mx::joint_matrix<sycl::sub_group, int8_t, mx::use::b, DP_TK, DP_TN, mx::layout::ext_intel_packed> bm;
+                    mx::joint_matrix_load(sg, bm, bg + (size_t) bb * DP_TK * NC + (size_t) t * DP_TN * 4, NC * 4);
+                    mx::joint_matrix_fill(sg, cu[t], 0);
+                    mx::joint_matrix_fill(sg, cg[t], 0);
+                    mx::joint_matrix_mad(sg, cu[t], au, bm, cu[t]);
+                    mx::joint_matrix_mad(sg, cg[t], ag, bm, cg[t]);
+                }
+            };
+            auto accum = [&](int bb, auto & cu, auto & cg) {
+#pragma unroll
+                for (int t = 0; t < NT; ++t) {
+                    const float * dab = da + (size_t) bb * NC + t * DP_TN;
+                    int e = 0;
+                    mxi::joint_matrix_apply(sg, cu[t], [&](int32_t & x, size_t r, size_t col) {
+                        fu[t][e++] += (float) x * (float) du[(size_t) (row0 + r) * bpr + bb] * dab[col];
+                    });
+                    e = 0;
+                    mxi::joint_matrix_apply(sg, cg[t], [&](int32_t & x, size_t r, size_t col) {
+                        fg[t][e++] += (float) x * (float) dg[(size_t) (row0 + r) * bpr + bb] * dab[col];
+                    });
+                }
+            };
+            int b = b0;
+            for (; b + UNR <= b1; b += UNR) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> cu[UNR][NT], cg[UNR][NT];
+#pragma unroll
+                for (int u = 0; u < UNR; ++u) step(b + u, cu[u], cg[u]);
+#pragma unroll
+                for (int u = 0; u < UNR; ++u) accum(b + u, cu[u], cg[u]);
+            }
+            for (; b < b1; ++b) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> cu[NT], cg[NT];
+                step(b, cu, cg);
+                accum(b, cu, cg);
+            }
+
+            mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> coords;
+            mx::joint_matrix_fill(sg, coords, 0);
+#pragma unroll
+            for (int t = 0; t < NT; ++t) {
+                int e = 0;
+                mxi::joint_matrix_apply(sg, coords, [&](int32_t &, size_t r, size_t col) {
+                    red[((0 * KSPLIT + s) * DP_TM + r) * NC + t * DP_TN + col] = fu[t][e];
+                    red[((1 * KSPLIT + s) * DP_TM + r) * NC + t * DP_TN + col] = fg[t][e];
+                    ++e;
+                });
+            }
+            sycl::group_barrier(it.get_group());
+            for (int idx = it.get_local_id(0); idx < DP_TM * NC; idx += KSPLIT * DP_SG) {
+                const int r = idx / NC, col = idx % NC;
+                if (col < ntok) {
+                    float up = 0.0f, gate = 0.0f;
+#pragma unroll
+                    for (int k = 0; k < KSPLIT; ++k) {
+                        up   += red[((0 * KSPLIT + k) * DP_TM + r) * NC + col];
+                        gate += red[((1 * KSPLIT + k) * DP_TM + r) * NC + col];
+                    }
+                    out[(size_t) col * s_out + row0 + r] = gate / (1.0f + sycl::native::exp(-gate)) * up;
+                }
+            }
+        });
+    });
+}
+
+// GGML_SYCL_Q8_DPAS_WIDE=1: 9..48 tokens (independent of GGML_SYCL_Q8_DPAS, which serves 2..8)
+constexpr int DP_WIDE_MIN = 9, DP_WIDE_MAX = 3 * DP_TN;
+bool dpas_wide(int ntok) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS_WIDE", 0) == 1;
+    return enabled && ntok >= DP_WIDE_MIN && ntok <= DP_WIDE_MAX;
+}
+
+}  // namespace
+
+bool ggml_sycl_q8_dpas_swiglu(ggml_backend_sycl_context & ctx, const void * wu, const void * wg, const float * act,
+                              int64_t act_stride, int ntok, int K, int M, float * out, int64_t out_stride) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS", 0) == 1;
+    static const bool fused   = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS_FUSED_GLU", 0) == 1;
+    const bool        wide    = dpas_wide(ntok);
+    if ((!wide && (!enabled || !fused || ntok < 2 || ntok > DP_TN / 2)) || K % DP_TK != 0 || M % DP_TM != 0) {
+        return false;
+    }
+    queue_ptr stream = ctx.stream();
+    const int bpr = K / DP_TK;
+    const int nt  = (ntok + DP_TN - 1) / DP_TN;
+    ggml_sycl_pool_alloc<int8_t> bp(ctx.pool(), (size_t) K * DP_TN * nt);
+    ggml_sycl_pool_alloc<float>  da(ctx.pool(), (size_t) bpr * DP_TN * nt);
+    dpas_quantize(*stream, act, act_stride, ntok, K, bp.get(), da.get(), DP_TN * nt);
+    const int8_t * qu = (const int8_t *) wu;
+    const int8_t * qg = (const int8_t *) wg;
+    const half *   du = (const half *) ((const char *) wu + (size_t) M * K);
+    const half *   dg = (const half *) ((const char *) wg + (size_t) M * K);
+    if (nt == 2) {
+        dpas_glu_swiglu<8, 1, 2>(*stream, qu, du, qg, dg, bp.get(), da.get(), out, out_stride, M, K, ntok);
+        return true;
+    }
+    if (nt == 3) {
+        dpas_glu_swiglu<8, 1, 3>(*stream, qu, du, qg, dg, bp.get(), da.get(), out, out_stride, M, K, ntok);
+        return true;
+    }
+    if (K <= 4096) {
+        dpas_glu_swiglu<2, 2>(*stream, qu, du, qg, dg, bp.get(), da.get(), out, out_stride, M, K, ntok);
+    } else {
+        dpas_glu_swiglu<8, 2>(*stream, qu, du, qg, dg, bp.get(), da.get(), out, out_stride, M, K, ntok);
+    }
+    return true;
+}
+
+bool ggml_sycl_q8_dpas_glu_pair(ggml_backend_sycl_context & ctx, const void * wu, const void * wg, const float * act,
+                                int64_t act_stride, int ntok, int K, int M, float * up_out, float * gate_out) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS", 0) == 1;
+    if (!enabled || ntok < 2 || ntok > DP_TN / 2 || K % DP_TK != 0 || M % DP_TM != 0) {
+        return false;
+    }
+    queue_ptr stream = ctx.stream();
+    const int bpr = K / DP_TK;
+    ggml_sycl_pool_alloc<int8_t> bp(ctx.pool(), (size_t) K * DP_TN);
+    ggml_sycl_pool_alloc<float>  da(ctx.pool(), (size_t) bpr * DP_TN);
+    dpas_quantize(*stream, act, act_stride, ntok, K, bp.get(), da.get());
+    const void * w[2]   = { wu, wg };
+    float *      out[2] = { up_out, gate_out };
+    for (int i = 0; i < 2; ++i) {
+        const int8_t * qs = (const int8_t *) w[i];
+        const half *   dw = (const half *) ((const char *) w[i] + (size_t) M * K);
+        if (K <= 4096) {
+            dpas_gemv<2, 4>(*stream, qs, dw, bp.get(), da.get(), out[i], M, M, K, ntok);
+        } else {
+            dpas_gemv<8, 4>(*stream, qs, dw, bp.get(), da.get(), out[i], M, M, K, ntok);
+        }
+    }
+    return true;
+}
+
+bool ggml_sycl_mul_mat_q8_dpas(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                               ggml_tensor * dst) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS", 0) == 1;
+    const int64_t K = src0->ne[0], M = src0->ne[1], ntok = src1->ne[1];
+    const bool    wide = ntok <= DP_WIDE_MAX && dpas_wide((int) ntok);
+    if (!enabled && !wide) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q8_0 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        ntok < 2 || (!wide && ntok > DP_TN / 2) || K % DP_TK != 0 || M % DP_TM != 0 ||
+        src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->ne[0] != K ||
+        !ggml_is_contiguous(src0) || src1->nb[0] != sizeof(float) || !ggml_is_contiguous(dst) || dst->ne[0] != M) {
+        return false;
+    }
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (!extra || !extra->optimized_feature.reorder) {
+        return false;  // the A loads assume the reordered layout (row-major qs, then scales)
+    }
+    static bool logged = false, logged_wide = false;
+    if (!wide && !logged) {
+        GGML_LOG_WARN("%s: GGML_SYCL_Q8_DPAS active (integer DPAS for 2..8-token Q8_0 mul_mat)\n", __func__);
+        logged = true;
+    }
+    if (wide && !logged_wide) {
+        GGML_LOG_WARN("%s: GGML_SYCL_Q8_DPAS_WIDE active (integer DPAS for 9..48-token Q8_0 mul_mat)\n", __func__);
+        logged_wide = true;
+    }
+    queue_ptr stream = ctx.stream();
+    const int bpr = (int) (K / DP_TK);
+    const int nt  = (int) (ntok + DP_TN - 1) / DP_TN;
+    ggml_sycl_pool_alloc<int8_t> bp(ctx.pool(), (size_t) K * DP_TN * nt);
+    ggml_sycl_pool_alloc<float>  da(ctx.pool(), (size_t) bpr * DP_TN * nt);
+
+    const int8_t * qs = (const int8_t *) src0->data;
+    const half *   dw = (const half *) ((const char *) src0->data + (size_t) M * K);
+
+    dpas_quantize(*stream, (const float *) src1->data, (int64_t) (src1->nb[1] / sizeof(float)), (int) ntok, (int) K,
+                  bp.get(), da.get(), DP_TN * nt);
+    float * out = (float *) dst->data;
+    const int64_t s_out = (int64_t) (dst->nb[1] / sizeof(float));
+    if (nt == 2) {
+        dpas_gemv<8, 2, 2>(*stream, qs, dw, bp.get(), da.get(), out, s_out, (int) M, (int) K, (int) ntok);
+        return true;
+    }
+    if (nt == 3) {
+        dpas_gemv<8, 1, 3>(*stream, qs, dw, bp.get(), da.get(), out, s_out, (int) M, (int) K, (int) ntok);
+        return true;
+    }
+    if (K <= 4096) {
+        dpas_gemv<2, 4>(*stream, qs, dw, bp.get(), da.get(), out, s_out, (int) M, (int) K, (int) ntok);
+    } else {
+        dpas_gemv<8, 4>(*stream, qs, dw, bp.get(), da.get(), out, s_out, (int) M, (int) K, (int) ntok);
+    }
+    return true;
+}
