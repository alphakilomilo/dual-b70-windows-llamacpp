+// phase 1 (end): checks both threads made the same exchanges and folds the counters back.
+static bool ggml_backend_sycl_comm_parallel(void * comm_v, int phase, int64_t max_nelem) try {
+    auto * comm = static_cast<ggml_backend_sycl_comm_context *>(comm_v);
+    if (comm == nullptr || comm->backends.size() != 2) {
+        return false;
+    }
+    queue_ptr q0 = ((ggml_backend_sycl_context *) comm->backends[0]->context)->stream();
+    queue_ptr q1 = ((ggml_backend_sycl_context *) comm->backends[1]->context)->stream();
+    if (phase == 1) {
+        GGML_ASSERT(comm->dev_parity[0] == comm->dev_parity[1] && comm->dev_seq[0] == comm->dev_seq[1]);
+        comm->direct_parity = comm->dev_parity[0];
+        comm->flag_seq      = comm->dev_seq[0];
+        return true;
+    }
+    static const bool ok_env = ggml_sycl_get_env("GGML_SYCL_TP_DIRECT", 0) == 1 &&
+                               ggml_sycl_get_env("GGML_SYCL_TP_GPUFLAG", 0) == 1 &&
+                               ggml_sycl_get_env("GGML_SYCL_TP_FUSED_AR", 0) != 1;
+    if (!ok_env || !ggml_sycl_same_native_context(*q0, *q1)) {
+        return false;
+    }
+    const size_t need = (size_t) std::max<int64_t>(max_nelem, 1) * 4;
+    if (comm->direct_bytes < need || comm->buf_nelem < max_nelem || !comm->gpuflag) {
+        q0->wait();
+        q1->wait();
+    }
+    if (comm->direct_bytes < need) {
+        for (int d = 0; d < 2; ++d) {
+            for (int p = 0; p < 2; ++p) {
+                if (comm->direct_out[d][p]) { sycl::free(comm->direct_out[d][p], q0->get_context()); }
+                comm->direct_out[d][p] = sycl::malloc_host<uint8_t>(need, q0->get_context());
+                GGML_ASSERT(comm->direct_out[d][p]);
+            }
+        }
+        comm->direct_bytes = need;
+    }
+    if (comm->buf_nelem < max_nelem) {
+        comm->buf0->realloc(max_nelem * 4);
+        comm->buf1->realloc(max_nelem * 4);
+        comm->buf_nelem = max_nelem;
+    }
+    if (!comm->gpuflag) {
+        comm->gpuflag = sycl::malloc_host<uint32_t>(64, q0->get_context());
+        GGML_ASSERT(comm->gpuflag);
+        std::memset(comm->gpuflag, 0, 64 * sizeof(uint32_t));
+    }
+    comm->dev_parity[0] = comm->dev_parity[1] = comm->direct_parity;
+    comm->dev_seq[0]    = comm->dev_seq[1]    = comm->flag_seq;
+    return true;
+}
+catch (const sycl::exception &) { return false; }
+
+// Device j's half of ggml_backend_sycl_comm_allreduce_tensor on the device-joined path (same kernels, same
+// arithmetic, so results are bit-identical to the two-device call). j < 0: only report whether the tensors are
+// supported. Buffers must have been sized by ggml_backend_sycl_comm_parallel(phase 0).
+static bool ggml_backend_sycl_comm_allreduce_tensor_dev(void * comm_v, ggml_tensor ** tensors, int j) {
+    auto * comm = static_cast<ggml_backend_sycl_comm_context *>(comm_v);
+    if (comm == nullptr || comm->backends.size() != 2 || !ggml_sycl_comm_dev_supported(tensors)) {
+        return false;
+    }
+    if (j < 0) {
+        return true;
+    }
+    const int64_t nelem = ggml_nelements(tensors[j]);
+    if (nelem == 0) {
+        return true;
+    }
+    GGML_ASSERT(nelem <= comm->buf_nelem && (size_t) nelem * 4 <= comm->direct_bytes);
+    queue_ptr q   = ((ggml_backend_sycl_context *) comm->backends[j]->context)->stream();
+    uint8_t * buf = (j == 0 ? comm->buf0 : comm->buf1)->get();
+
+    // dst <- peer's src through the ping-pong host buffers, joined on the device
+    auto exchange = [&](void * dst, const void * src, size_t nbytes) {
+        const int p = (comm->dev_parity[j] ^= 1);
+        q->memcpy(comm->direct_out[j][p], src, nbytes);
+        uint32_t * f = comm->gpuflag;
+        if (f[32] || f[48]) {
+            GGML_ABORT("GGML_SYCL_TP_GPUFLAG: device join timed out (dev0 seq %u, dev1 seq %u)", f[32], f[48]);
+        }
+        const uint32_t s = ++comm->dev_seq[j];
+        ggml_sycl_gpuflag_join(q, f + 16 * j, f + 16 * (1 - j), f + 32 + 16 * j, s);
+        q->memcpy(dst, comm->direct_out[1 - j][p], nbytes);
+    };
+
+    if (tensors[j]->type == GGML_TYPE_F16) {
+        sycl::half * out = (sycl::half *) tensors[j]->data;
+        sycl::half * tmp = (sycl::half *) buf;
+        exchange(tmp, out, ggml_nbytes(tensors[j]));
+        q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) { out[i] = (sycl::half) ((float) out[i] + (float) tmp[i]); });
+        return true;
+    }
+
+    float * out = (float *) tensors[j]->data;
+    static constexpr int64_t BF16_THRESHOLD = 32768;  // same as ggml_backend_sycl_comm_allreduce_tensor
+    if (nelem < BF16_THRESHOLD) {
+        float * tmp = (float *) buf;
+        exchange(tmp, out, ggml_nbytes(tensors[j]));
+        q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) { out[i] += tmp[i]; });
+        return true;
+    }
+
+    uint16_t * outbox = (uint16_t *) buf;
+    uint16_t * inbox  = outbox + nelem;
+    static const bool bf16_sym = ggml_sycl_get_env("GGML_SYCL_TP_BF16_SYM", 0) == 1;
+    if (bf16_sym) {
+        q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) {
+            const uint32_t u = sycl::bit_cast<uint32_t>(out[i]);
+            outbox[i] = (uint16_t) ((u + 0x7FFFu + ((u >> 16) & 1u)) >> 16);
+        });
+    } else {
+        q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) { outbox[i] = (uint16_t) (sycl::bit_cast<uint32_t>(out[i]) >> 16); });
+    }
+    exchange(inbox, outbox, nelem * sizeof(uint16_t));
+    if (bf16_sym) {
+        q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) {
+            out[i] = sycl::bit_cast<float>(((uint32_t) outbox[i]) << 16) + sycl::bit_cast<float>(((uint32_t) inbox[i]) << 16);
+        });
+    } else {
+        q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) { out[i] += sycl::bit_cast<float>(((uint32_t) inbox[i]) << 16); });
+    }
+    return true;
+}
