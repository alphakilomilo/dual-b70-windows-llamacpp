+// device wrote. Needs both queues in one SYCL context. The B70s share the platform default context but report no
+// peer access, and a cross-device event wait aborts, so the host still joins once per exchange.
+// GGML_SYCL_TP_TILES: exchange of two BF16 partials the producers wrote tile by tile (ev[d][t] marks tile t of device
+// d done). Each tile is copied out on the device's send queue as soon as it is ready, overlapping the remaining tiles'
+// GEMMs; the host then waits for each device's last copy-out and the other device pulls the whole partial with a kernel.
+// src[d] are device buffers, dst[d] the receiving inboxes; both queues end ordered after their own copy-outs.
+static void ggml_sycl_comm_exchange_tiled(ggml_backend_sycl_comm_context * comm, queue_ptr q0, queue_ptr q1,
+                                          void * dst0, void * dst1, const uint8_t * src0, const uint8_t * src1,
+                                          size_t nbytes, const std::vector<sycl::event> * ev) {
+    if (comm->direct_bytes < nbytes) {
+        q0->wait();
+        q1->wait();
+        for (int d = 0; d < 2; ++d) {
+            for (int p = 0; p < 2; ++p) {
+                if (comm->direct_out[d][p]) { sycl::free(comm->direct_out[d][p], q0->get_context()); }
+                comm->direct_out[d][p] = sycl::malloc_host<uint8_t>(nbytes, q0->get_context());
+                GGML_ASSERT(comm->direct_out[d][p]);
+            }
+        }
+        comm->direct_bytes = nbytes;
+    }
+    const int p = (comm->direct_parity ^= 1);
+    queue_ptr       qs[2]  = { q0, q1 };
+    const uint8_t * src[2] = { src0, src1 };
+    sycl::event     last[2];
+    const size_t    ntile  = ev[0].size();
+    const size_t    tbytes = nbytes / ntile;
+    for (int d = 0; d < 2; ++d) {
+        if (!comm->send_q[d]) {
+            comm->send_q[d] = std::make_unique<sycl::queue>(qs[d]->get_context(), qs[d]->get_device(), sycl::property::queue::in_order());
+        }
+        for (size_t t = 0; t < ntile; ++t) {
+            last[d] = comm->send_q[d]->memcpy(comm->direct_out[d][p] + t * tbytes, src[d] + t * tbytes, tbytes, ev[d][t]);
