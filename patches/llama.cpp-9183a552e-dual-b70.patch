+// DSpine (tencent/*-DSpine-b16): the selected-prefix code bridge writes, after every draft layer, a gated message from
+// each block position's predecessor into its residual stream. Follows the reference (dspine_mlx/bridge.py, matching
+// sglang_dspine/models/dspine.py) in f32 instead of its bf16 rounding points:
+//   rms = sqrt(mean(f^2)); codes = sqrt(C) * l2norm(read_w(il) . f / (rms + eps)); row 0 = sqrt(C) * codebook[anchor]
+//   q, s, v = gate . codes, predecessor_gate . codes, prev . codes
+//   f[t] += rms[t] * write(il) . (sigmoid(q[t] + s[t-1] + b) * v[t-1])        for t >= 1
+// The rows of the last layer before its write (f, rms, q) feed the refinement table (build_dspine_lattice).
+struct dspine_stash {
+    ggml_tensor * raw = nullptr; // [n_embd, T - 1, n_blocks]
+    ggml_tensor * rms = nullptr; // [1,      T - 1, n_blocks]
+    ggml_tensor * q   = nullptr; // [rank,   T - 1, n_blocks]
+};
+
+static ggml_tensor * dspine_rows(ggml_context * ctx0, ggml_tensor * t, int64_t r0, int64_t n) {
+    return ggml_view_3d(ctx0, t, t->ne[0], n, t->ne[2], t->nb[1], t->nb[2], r0 * t->nb[1]);
+}
+
+static ggml_tensor * dspine_anchor_ids(ggml_context * ctx0, ggml_tensor * tokens, int64_t T, int64_t n_blocks) {
+    return ggml_cont_1d(ctx0, ggml_view_2d(ctx0, tokens, 1, n_blocks, T * tokens->nb[0], 0), n_blocks);
+}
+
+static ggml_tensor * build_dspine_write(llm_graph_context & g, const llama_model & model, ggml_tensor * f,
+        ggml_tensor * tokens, int il, dspine_stash * stash) {
+    ggml_context * ctx0 = g.ctx0;
+
+    const int64_t n_embd   = f->ne[0];
+    const int64_t n_tokens = f->ne[1];
+    const int64_t n_blocks = g.ubatch.n_seqs_unq;
+    GGML_ASSERT(n_blocks > 0 && n_tokens % n_blocks == 0);
+    const int64_t T = n_tokens / n_blocks;
+    // LLAMA_DSPINE_DBG (diagnostic bits): 1 = skip the bridge writes, 2 = lattice without refinement
+    static const int dbg = getenv("LLAMA_DSPINE_DBG") ? atoi(getenv("LLAMA_DSPINE_DBG")) : 0;
+    if (T < 2 || tokens == nullptr || (dbg & 1)) {
+        return f;
+    }
+    // feature_layers are 1-based; the export validator requires the last layer among them
+    if (!model.dspine_active_layers.empty() &&
+        !std::binary_search(model.dspine_active_layers.begin(), model.dspine_active_layers.end(), (uint32_t) il + 1)) {
+        return f;
+    }
+    const int64_t code   = model.dspine_codebook->ne[0];
+    const int64_t rank   = model.dspine_gate->ne[1];
+    const float   eps    = model.dspine_eps; // the bridge's own epsilon (reference: x / (norm + eps))
+    const float   sqrt_c = sqrtf((float) code);
+    const bool    last   = il == (int) g.n_layer - 1;
+
+    // LLAMA_DSPINE_BF16_ROUND=1: round through BF16 where the reference does (bridge.py); default keeps F32
+    static const bool bf16_round = getenv("LLAMA_DSPINE_BF16_ROUND") && atoi(getenv("LLAMA_DSPINE_BF16_ROUND")) != 0;
+    auto rb = [&](ggml_tensor * x) {
+        return bf16_round ? ggml_cast(ctx0, ggml_cast(ctx0, x, GGML_TYPE_BF16), GGML_TYPE_F32) : x;
+    };
+    f = rb(f);
+
+    ggml_tensor * rms  = ggml_sqrt(ctx0, ggml_mean(ctx0, ggml_sqr(ctx0, f)));                  // [1, n_tokens]
+    ggml_tensor * norm = rb(ggml_div(ctx0, f, ggml_scale_bias(ctx0, rms, 1.0f, eps)));
+
+    ggml_tensor * read_w = last ? model.dspine_read
+        : ggml_view_2d(ctx0, model.dspine_early_read, n_embd, code, model.dspine_early_read->nb[1],
+                       il * model.dspine_early_read->nb[2]);
+    // sqrt(C) * proj / (||proj|| + eps), as the reference (ggml_l2_norm would divide by max(||proj||, eps))
+    ggml_tensor * proj  = ggml_mul_mat(ctx0, read_w, norm);
+    ggml_tensor * pnorm = ggml_scale_bias(ctx0, ggml_sqrt(ctx0, ggml_sum_rows(ctx0, ggml_sqr(ctx0, proj))), 1.0f, eps);
+    ggml_tensor * codes = rb(ggml_scale(ctx0, ggml_div(ctx0, proj, pnorm), sqrt_c));
+
+    // row 0 of every block reads the anchor token's code instead of its own
+    ggml_tensor * anchor_codes = ggml_reshape_3d(ctx0,
+            rb(ggml_scale(ctx0, ggml_get_rows(ctx0, model.dspine_codebook, dspine_anchor_ids(ctx0, tokens, T, n_blocks)), sqrt_c)),
+            code, 1, n_blocks);
+    ggml_tensor * codes3 = ggml_reshape_3d(ctx0, codes, code, T, n_blocks);
+    codes3 = ggml_concat(ctx0, anchor_codes, ggml_cont(ctx0, dspine_rows(ctx0, codes3, 1, T - 1)), 1);
+    codes  = ggml_reshape_2d(ctx0, codes3, code, n_tokens);
+
+    ggml_tensor * q = ggml_reshape_3d(ctx0, rb(ggml_mul_mat(ctx0, model.dspine_gate,      codes)), rank, T, n_blocks);
+    ggml_tensor * s = ggml_reshape_3d(ctx0, rb(ggml_mul_mat(ctx0, model.dspine_pred_gate, codes)), rank, T, n_blocks);
+    ggml_tensor * v = ggml_reshape_3d(ctx0, rb(ggml_mul_mat(ctx0, model.dspine_prev,      codes)), rank, T, n_blocks);
+
+    ggml_tensor * q_succ = ggml_cont(ctx0, dspine_rows(ctx0, q, 1, T - 1));
+    ggml_tensor * gate   = ggml_sigmoid(ctx0, ggml_add(ctx0,
+            ggml_add(ctx0, q_succ, ggml_cont(ctx0, dspine_rows(ctx0, s, 0, T - 1))), model.dspine_gate_b));
+    ggml_tensor * msg    = rb(ggml_mul(ctx0, gate, ggml_cont(ctx0, dspine_rows(ctx0, v, 0, T - 1))));  // [rank, T-1, nb]
+
+    ggml_tensor * write_w = ggml_view_2d(ctx0, model.dspine_write, rank, n_embd, model.dspine_write->nb[1],
+                                         il * model.dspine_write->nb[2]);
+    ggml_tensor * delta = ggml_mul_mat(ctx0, write_w, ggml_reshape_2d(ctx0, msg, rank, (T - 1) * n_blocks));
+    delta = ggml_reshape_3d(ctx0, delta, n_embd, T - 1, n_blocks);
+
+    ggml_tensor * f3      = ggml_reshape_3d(ctx0, f,   n_embd, T, n_blocks);
+    ggml_tensor * rms3    = ggml_reshape_3d(ctx0, rms, 1,      T, n_blocks);
+    ggml_tensor * f_succ  = ggml_cont(ctx0, dspine_rows(ctx0, f3,   1, T - 1));
+    ggml_tensor * rms_suc = ggml_cont(ctx0, dspine_rows(ctx0, rms3, 1, T - 1));
+    ggml_tensor * upd     = ggml_add(ctx0, f_succ, ggml_mul(ctx0, delta, rms_suc));
+    ggml_tensor * out     = rb(ggml_concat(ctx0, ggml_cont(ctx0, dspine_rows(ctx0, f3, 0, 1)), upd, 1));
+
+    if (last && stash) {
+        stash->raw = f_succ;
+        stash->rms = rms_suc;
+        stash->q   = q_succ;
+    }
+    g.cb(out, "dspine_write", il);
+    return ggml_reshape_2d(ctx0, out, n_embd, n_tokens);
+}
+
+// DSpine refinement: for every block position t >= 1 and every candidate of its predecessor (the anchor for t = 1,
+// the top-k of t - 1 otherwise), redo the last layer's write with that token's exact code and score the top-k of t
+// through the final norm and the output head. The result fills the DFlash2 lattice rows (candidates, k x k scores
+// with the successor fastest, the unrefined head logits), so the drafting side walks it like DFlash2's selector.
+static void build_dspine_lattice(llm_graph_context & g, const llama_model & model, ggml_tensor * tokens,
+        ggml_tensor * head, const dspine_stash & stash) {
+    ggml_context * ctx0 = g.ctx0;
+    auto         & res  = g.res;
+
+    const int64_t n_tokens = g.n_tokens;
+    const int64_t n_embd   = g.n_embd;
+    const int64_t n_blocks = g.ubatch.n_seqs_unq;
+    const int64_t top_k    = g.hparams.dflash_selector_top_k;
+    GGML_ASSERT(n_blocks > 0 && n_tokens % n_blocks == 0 && res->t_logits->ne[1] == n_tokens);
+    const int64_t T = n_tokens / n_blocks;
+    static const int dbg = getenv("LLAMA_DSPINE_DBG") ? atoi(getenv("LLAMA_DSPINE_DBG")) : 0;
+    if (!tokens || T < 2 || (stash.raw == nullptr && !(dbg & 1))) {
+        return;
+    }
+    const int64_t rank     = model.dspine_gate->ne[1];
+    const int64_t code     = model.dspine_codebook->ne[0];
+    const int64_t row_used = top_k + top_k * top_k + top_k;
+    const float   sqrt_c   = sqrtf((float) code);
+    const float   eps      = g.hparams.f_norm_rms_eps;
+    GGML_ASSERT(row_used <= n_embd);
+
+    ggml_tensor * candidates  = ggml_top_k(ctx0, res->t_logits, top_k);
+    ggml_tensor * logits_rows = ggml_reshape_3d(ctx0, res->t_logits, 1, res->t_logits->ne[0], n_tokens);
+    ggml_tensor * unary       = ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, logits_rows, candidates), top_k, n_tokens);
+    ggml_tensor * cand_blk    = ggml_reshape_3d(ctx0, candidates, top_k, T, n_blocks);
+    ggml_tensor * unary_blk   = ggml_reshape_3d(ctx0, unary,      top_k, T, n_blocks);
+    ggml_tensor * write_last  = ggml_view_2d(ctx0, model.dspine_write, rank, n_embd, model.dspine_write->nb[1],
+                                             (g.n_layer - 1) * model.dspine_write->nb[2]);
+
+    // LLAMA_DSPINE_RANK=0: rebuild the n_embd vectors even when the export carries the rank-space tensors
+    static const bool rank_env   = !getenv("LLAMA_DSPINE_RANK") || atoi(getenv("LLAMA_DSPINE_RANK")) != 0;
+    const bool        rank_space = rank_env && model.dspine_write_t && model.dspine_write_gram;
+
+    // positions [beg, beg + n_pos) against n_pred predecessor ids each (pred_ids: [n_pred * n_pos * n_blocks])
+    auto score_run = [&](int64_t beg, int64_t n_pos, ggml_tensor * pred_ids, int64_t n_pred) {
+        if (dbg & 3) {
+            ggml_tensor * cand_run  = ggml_cont(ctx0, dspine_rows(ctx0, cand_blk,  beg, n_pos));
+            ggml_tensor * unary_run = ggml_cont(ctx0, dspine_rows(ctx0, unary_blk, beg, n_pos));
+            ggml_tensor * score = ggml_repeat_4d(ctx0, ggml_reshape_4d(ctx0, unary_run, top_k, 1, n_pos, n_blocks),
+                    top_k, top_k, n_pos, n_blocks);
+            ggml_tensor * row = ggml_concat(ctx0, ggml_cast(ctx0, cand_run, GGML_TYPE_F32),
+                    ggml_reshape_3d(ctx0, score, top_k * top_k, n_pos, n_blocks), 0);
+            row = ggml_concat(ctx0, row, unary_run, 0);
+            GGML_UNUSED(pred_ids);
+            return ggml_pad(ctx0, row, (int) (n_embd - row_used), 0, 0, 0);
+        }
+        ggml_tensor * e   = ggml_scale(ctx0, ggml_get_rows(ctx0, model.dspine_codebook, pred_ids), sqrt_c);
+        ggml_tensor * pg  = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, model.dspine_pred_gate, e), rank, n_pred, n_pos, n_blocks);
+        ggml_tensor * val = ggml_reshape_4d(ctx0, ggml_mul_mat(ctx0, model.dspine_prev,      e), rank, n_pred, n_pos, n_blocks);
+
+        // stash rows are block positions 1..T-1, so position p is stash row p - 1
+        ggml_tensor * q_run   = ggml_reshape_4d(ctx0, ggml_cont(ctx0, dspine_rows(ctx0, stash.q,   beg - 1, n_pos)), rank,   1, n_pos, n_blocks);
+        ggml_tensor * raw_run = ggml_reshape_4d(ctx0, ggml_cont(ctx0, dspine_rows(ctx0, stash.raw, beg - 1, n_pos)), n_embd, 1, n_pos, n_blocks);
