+// Device-side join for GGML_SYCL_TP_GPUFLAG: after this queue's copy to host memory, publish `seq` in `mine` and
+// spin until the peer publishes the same `seq` in `peer`. Plain or atomic loads of host memory keep returning a
+// stale cached value on Arc Pro B70 (measured 2026-10-20), so the peer flag is read with an uncached L1/L3 hint.
+// The spin is capped (~0.5-1 s, under the Windows GPU timeout); on a miss it records `seq` in `err` and the next
+// exchange aborts instead of reading a half-written buffer silently.
+static void ggml_sycl_gpuflag_join(queue_ptr q, uint32_t * mine, const uint32_t * peer, uint32_t * err, uint32_t seq) {
+    using sys_atomic = sycl::atomic_ref<uint32_t, sycl::memory_order::relaxed, sycl::memory_scope::system,
+                                        sycl::access::address_space::global_space>;
+    q->single_task([=]() {
+        namespace sxe = sycl::ext::intel::experimental;
+        namespace sxo = sycl::ext::oneapi::experimental;
+        sys_atomic(*mine).store(seq, sycl::memory_order::release);
+        sxo::annotated_ptr<const volatile uint32_t, decltype(sxo::properties(
+            sxe::read_hint<sxe::cache_control<sxe::cache_mode::uncached, sxe::cache_level::L1, sxe::cache_level::L3>>))> pp(peer);
+        uint32_t k = 0;
+        while (*pp < seq) {
+            if (++k > 600000u) { *err = seq; break; }
+        }
+    });
