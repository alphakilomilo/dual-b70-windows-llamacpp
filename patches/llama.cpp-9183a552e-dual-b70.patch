--- a/ggml/src/ggml-sycl/gemm.hpp
+++ b/ggml/src/ggml-sycl/gemm.hpp
@@ -88,6 +88,43 @@ public:
 
         gemm(ctx, m, n, k, a, at, 1, k, k * m, b, bt, 1, k, n * k, c, ct, q, 1, 1);
     }
+
+    // dst[n][m] = src[n][k] x dequant(w)[m][k]^T for int8 weights w[m][k] with one f16 scale per 32 along k, given
+    // transposed as scales_t[k/32][m] (the layout oneDNN reads). oneDNN decompresses the weights inside the GEMM
+    // (f16 compute), so no f16 copy of the weights is written. Here the activations are oneDNN's src and the
+    // weights its weights operand, the opposite of row_gemm, because decompression applies to the weights operand.
+    // dst_t f32, or bf16 (rounded to nearest even from the f32 accumulation) for the tensor-parallel exchange
+    static void gemm_q8_0_weights(ggml_backend_sycl_context & ctx, int m, int n, int k, const int8_t * w,
+                                  const sycl::half * scales_t, const sycl::half * src, void * dst, const queue_ptr & q,
+                                  dt dst_t = dt::f32) {
+        auto stream = ctx.stream_dnnl(q);
+        auto eng    = ctx.engine_dnnl(q);
+
+        const dnnl::memory::desc src_md({ n, k }, dt::f16, dnnl::memory::dims{ k, 1 });
+        const dnnl::memory::desc w_md({ k, m }, dt::s8, dnnl::memory::dims{ 1, k });
+        const dnnl::memory::desc dst_md({ n, m }, dst_t, dnnl::memory::dims{ m, 1 });
+        const dnnl::memory::desc sc_md({ k / 32, m }, dt::f16, dnnl::memory::dims{ m, 1 });
+
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        attr.set_fpmath_mode(dnnl::fpmath_mode::f16, true);
+        attr.set_scales(DNNL_ARG_WEIGHTS, (1 << 0) | (1 << 1), { 32, 1 }, dt::f16);
