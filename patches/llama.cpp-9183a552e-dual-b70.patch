+    // LLAMA_SPEC_QCAL_DUMP=<file>: one line per position, the candidates' scores then their target probabilities
+    static FILE * dump = [] { const char * f = getenv("LLAMA_SPEC_QCAL_DUMP"); return f ? fopen(f, "w") : (FILE *) nullptr; }();
+    if (dump) {
+        for (size_t j = 0; j < q.size(); ++j) { fprintf(dump, "%.5g ", q[j].logit); }
+        for (size_t j = 0; j < q.size(); ++j) { fprintf(dump, "%.5g%c", pq[j], j + 1 < q.size() ? ' ' : '\n'); }
+        fflush(dump);
+    }
+    if (++g_qcal.n % 2000 == 0) {
+        std::string line;
+        for (int t = 0; t < spec_qcal_n; ++t) {
+            char buf[48];
+            snprintf(buf, sizeof(buf), " tau %.2f: %.4f |", spec_qcal_taus[t], g_qcal.acc[t] / g_qcal.n);
+            line += buf;
+        }
+        LOG_WRN("SPEC_QCAL over %ld positions: p mass on draft candidates %.4f, p(draft argmax) %.4f |%s\n", g_qcal.n,
+                g_qcal.cover / g_qcal.n, g_qcal.p_top / g_qcal.n, line.c_str());
+    }
+}
