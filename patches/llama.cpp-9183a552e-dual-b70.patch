+        ggml_tensor * score = nullptr;                                                                    // [k, P, n_pos, nb]
+        if (rank_space) {
+            // y_j = x + s W m_j never formed: with A_k = head_k * norm_w,
+            //   score_jk = (A_k.x + s (A_k W).m_j) / sqrt(|y_j|^2 / n_embd + eps)
