+// tree verification (src[2] = idx [d_conv, n_t]): mode 0 conv, mode 1 the last d_conv-1 inputs of each window
+static void ggml_sycl_ssm_conv_tree(ggml_backend_sycl_context & ctx, ggml_tensor * dst,
+                                    ggml_tensor * silu_dst = nullptr, const float * bias = nullptr) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * src2 = dst->src[2];
+    const int     mode    = ggml_get_op_params_i32(dst, 0);
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src2->type == GGML_TYPE_I32 && (mode == 1 || src1->type == GGML_TYPE_F32));
+    GGML_ASSERT(src0->nb[0] == sizeof(float) && src0->nb[1] == src0->ne[0] * sizeof(float));
+    const int     d_conv  = ggml_get_op_params_i32(dst, 1);
+    const int     d_inner = (int) src0->ne[1];
+    const int     ncs     = (int) src0->ne[0];
+    const int     n_t     = (int) (ggml_nelements(src2) / d_conv);
+    const float * sx      = (const float *) src0->data;
+    const float * w       = mode == 0 ? (const float *) src1->data : nullptr;
+    const int32_t * idx   = (const int32_t *) src2->data;
+    float *       out     = (float *) (silu_dst ? silu_dst : dst)->data;
+    const bool    apply_silu = silu_dst != nullptr;
+    queue *       q       = ctx.stream();
+
+    const size_t total = (size_t) d_inner * n_t;
+    const size_t wg    = 256;
+    const size_t ng    = (total + wg - 1) / wg;
+    if (mode == 0) {
+        q->parallel_for(nd_range<1>(range<1>(ng * wg), range<1>(wg)), [=](nd_item<1> it) {
+            const size_t i = it.get_global_id(0);
+            if (i >= total) return;
+            const int ch = (int) (i % d_inner);
+            const int t  = (int) (i / d_inner);
+            const float * s  = sx + (size_t) ch * ncs;
+            const float * cw = w + (size_t) ch * d_conv;
+            float sumf = 0.0f;
+            for (int i0 = 0; i0 < d_conv; ++i0) sumf += s[idx[t * d_conv + i0]] * cw[i0];
+            if (bias != nullptr) sumf += bias[ch];
+            out[(size_t) t * d_inner + ch] = apply_silu ? op_silu(sumf) : sumf; // [d_inner, n_t, 1]
+        });
+    } else {
+        q->parallel_for(nd_range<1>(range<1>(ng * wg), range<1>(wg)), [=](nd_item<1> it) {
+            const size_t i = it.get_global_id(0);
+            if (i >= total) return;
+            const int ch = (int) (i % d_inner);
+            const int t  = (int) (i / d_inner);
+            const float * s = sx + (size_t) ch * ncs;
+            float * o = out + ((size_t) t * d_inner + ch) * (d_conv - 1); // [d_conv-1, d_inner, n_t]
+            for (int j = 0; j < d_conv - 1; ++j) o[j] = s[idx[t * d_conv + 1 + j]];
+        });
+    }
+}
+
 void ggml_sycl_ssm_conv(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    if (dst->src[2] != nullptr) {
+        ggml_sycl_ssm_conv_tree(ctx, dst);
+        return;
+    }
     scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
     ggml_sycl_op_ssm_conv(ctx, dst);
 }
@@ -357,5 +410,9 @@ void ggml_sycl_ssm_conv_fused(ggml_backend_sycl_context & ctx, ggml_tensor * dst
         const ggml_tensor * bias_t = (add->src[0] == dst) ? add->src[1] : add->src[0];
         bias = static_cast<const float *>(bias_t->data);
     }
+    if (dst->src[2] != nullptr) {
+        ggml_sycl_ssm_conv_tree(ctx, dst, silu_dst, bias);
+        return;
+    }
     ggml_sycl_op_ssm_conv(ctx, dst, silu_dst, bias);
 }
diff --git a/ggml/src/ggml-sycl/tp-trace-test.hpp b/ggml/src/ggml-sycl/tp-trace-test.hpp
new file mode 100644
index 000000000..dca0b9bb6
--- /dev/null
+++ b/ggml/src/ggml-sycl/tp-trace-test.hpp
@@ -0,0 +1,103 @@
+#pragma once
+#include <pti/pti_view.h>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <io.h>
+#include <mutex>
+#include <stdexcept>
+
+static FILE * tp_trace_file_test = nullptr;
+static const char * tp_trace_control_test = nullptr;
+static std::mutex tp_trace_mutex_test;
+static std::atomic<uint64_t> tp_trace_begin_test{0}, tp_trace_end_test{UINT64_MAX};
+static bool tp_trace_stopped_test = false;
+static bool tp_trace_host_only_test = false;
+
+static bool tp_trace_active_test() {
+    return tp_trace_file_test && tp_trace_begin_test.load() != 0 && tp_trace_end_test.load() == UINT64_MAX;
+}
+
+static void tp_trace_request_test(unsigned char ** buffer, size_t * size) {
+    *size = 1024 * 1024;
+    *buffer = static_cast<unsigned char *>(std::malloc(*size));
+    if (!*buffer) { *size = 0; }
+}
+
+static void tp_trace_complete_test(unsigned char * buffer, size_t, size_t used) {
+    std::lock_guard<std::mutex> lock(tp_trace_mutex_test);
+    pti_view_record_base * base = nullptr;
+    while (ptiViewGetNextRecord(buffer, used, &base) == PTI_SUCCESS) {
+        const uint64_t lo = tp_trace_begin_test.load(), hi = tp_trace_end_test.load();
+        if (!lo) { continue; }
+        if (base->_view_kind == PTI_VIEW_DEVICE_GPU_KERNEL) {
+            const auto * r = reinterpret_cast<const pti_view_record_kernel *>(base);
+            if (r->_start_timestamp >= lo && r->_start_timestamp < hi) {
+                std::fprintf(tp_trace_file_test, "K\t%s\t%llu\t%llu\t%llu\t%llu\t%llu\t%s\n", r->_pci_address,
+                    (unsigned long long) r->_start_timestamp, (unsigned long long) r->_end_timestamp,
+                    (unsigned long long) r->_append_timestamp, (unsigned long long) r->_submit_timestamp,
+                    (unsigned long long) r->_sycl_queue_id, r->_name);
+            }
+        } else if (base->_view_kind == PTI_VIEW_DEVICE_GPU_MEM_COPY) {
+            const auto * r = reinterpret_cast<const pti_view_record_memory_copy *>(base);
+            if (r->_start_timestamp >= lo && r->_start_timestamp < hi) {
+                std::fprintf(tp_trace_file_test, "C\t%s\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%d\n", r->_pci_address,
+                    (unsigned long long) r->_start_timestamp, (unsigned long long) r->_end_timestamp,
+                    (unsigned long long) r->_append_timestamp, (unsigned long long) r->_submit_timestamp,
+                    (unsigned long long) r->_sycl_queue_id, (unsigned long long) r->_bytes, int(r->_memcpy_type));
+            }
+        }
+    }
+    std::fflush(tp_trace_file_test);
+    std::free(buffer);
+}
+
+static void tp_trace_init_test() {
+    const char * output = std::getenv("GGML_SYCL_TP_TRACE_OUTPUT_TEST");
+    if (!output) { return; }
+    tp_trace_control_test = std::getenv("GGML_SYCL_TP_TRACE_CONTROL_TEST");
+    if (!tp_trace_control_test) { throw std::runtime_error("Trace control path required"); }
+    tp_trace_file_test = std::fopen(output, "w");
+    if (!tp_trace_file_test) { throw std::runtime_error("Trace output open failed"); }
+    tp_trace_host_only_test = std::getenv("GGML_SYCL_TP_TRACE_HOST_ONLY_TEST") != nullptr;
+    if (!tp_trace_host_only_test && (ptiViewSetCallbacks(tp_trace_request_test, tp_trace_complete_test) != PTI_SUCCESS ||
+        ptiViewEnable(PTI_VIEW_DEVICE_GPU_KERNEL) != PTI_SUCCESS ||
+        ptiViewEnable(PTI_VIEW_DEVICE_GPU_MEM_COPY) != PTI_SUCCESS)) {
+        throw std::runtime_error("PTI views unavailable");
+    }
+    GGML_LOG_WARN("TP_TRACE_TEST: initialized host_only=%d, awaiting capture marker\n", int(tp_trace_host_only_test));
+}
+
+static void tp_trace_update_test() {
+    if (!tp_trace_file_test || tp_trace_stopped_test) { return; }
+    const bool marker = _access(tp_trace_control_test, 0) == 0;
+    if (marker && tp_trace_begin_test.load() == 0) {
+        tp_trace_begin_test.store(ptiViewGetTimestamp());
+        GGML_LOG_WARN("TP_TRACE_TEST: capture started\n");
+    } else if (!marker && tp_trace_begin_test.load() != 0) {
+        tp_trace_end_test.store(ptiViewGetTimestamp());
+        tp_trace_stopped_test = true;
+        if (!tp_trace_host_only_test && (ptiViewDisable(PTI_VIEW_DEVICE_GPU_KERNEL) != PTI_SUCCESS ||
+            ptiViewDisable(PTI_VIEW_DEVICE_GPU_MEM_COPY) != PTI_SUCCESS || ptiFlushAllViews() != PTI_SUCCESS)) {
+            throw std::runtime_error("PTI flush failed");
+        }
+        std::lock_guard<std::mutex> lock(tp_trace_mutex_test);
+        std::fprintf(tp_trace_file_test, "W\t%llu\t%llu\n", (unsigned long long) tp_trace_begin_test.load(),
+            (unsigned long long) tp_trace_end_test.load());
+        std::fflush(tp_trace_file_test);
+        GGML_LOG_WARN("TP_TRACE_TEST: capture flushed\n");
+    }
+}
+
+static void tp_trace_graph_test(int device, int nodes, uint64_t begin, uint64_t end) {
+    std::lock_guard<std::mutex> lock(tp_trace_mutex_test);
+    std::fprintf(tp_trace_file_test, "G\t%d\t%d\t%llu\t%llu\n", device, nodes,
+        (unsigned long long) begin, (unsigned long long) end);
+}
+
+static void tp_trace_exchange_test(size_t bytes, uint64_t t0, uint64_t t1, uint64_t t2, uint64_t t3, uint64_t t4) {
+    std::lock_guard<std::mutex> lock(tp_trace_mutex_test);
+    std::fprintf(tp_trace_file_test, "X\t%zu\t%llu\t%llu\t%llu\t%llu\t%llu\n", bytes,
+        (unsigned long long) t0, (unsigned long long) t1, (unsigned long long) t2,
+        (unsigned long long) t3, (unsigned long long) t4);
+}
