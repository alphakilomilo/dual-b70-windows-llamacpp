diff --git a/ggml/src/ggml-sycl/fattn-xmx.cpp b/ggml/src/ggml-sycl/fattn-xmx.cpp
new file mode 100644
index 000000000..cbd89c2d6
--- /dev/null
+++ b/ggml/src/ggml-sycl/fattn-xmx.cpp
@@ -0,0 +1,268 @@
+// XMX split-K flash attention for speculative verify on Intel Xe2 (Arc Pro B70).
+//
+// Scope: D = 256, Q heads per KV head = 6, 1..8 query tokens, one sequence, F16 K/V (cache views), F16 mask,
+// no sinks / ALiBi / softcap, n_kv a multiple of 128. All 48 query rows (8 tokens x 6 heads) of a KV head go
+// through the matrix units together, so every K/V byte is read once per step:
+//   S^T = K * Q^T   A = K tile (8 keys x 16 dims, from the cache), B = Q^T (SLM, pre-scaled f16)
+//   O  += P * V     A = P (SLM f16, online softmax), B = V tile (16 keys x 16 dims, from the cache)
+// A work-group handles one KV head x one contiguous chunk of keys; a second kernel merges the chunks.
+// The TILE kernel this replaces grouped heads in pairs for gqa 6 (K/V read three times) and ran the dot products
+// on the vector units; measured per GPU at 131K keys, 8 tokens: 1.82 ms -> 0.77 ms (standalone prototype).
+
+#include <sycl/sycl.hpp>
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+#include "fattn-xmx.hpp"
+
+namespace {
+
+namespace mx  = sycl::ext::oneapi::experimental::matrix;
+namespace mxi = sycl::ext::intel::experimental::matrix;
+using half    = sycl::half;
+
+constexpr int XD   = 256;        // head size
+constexpr int XG   = 6;          // query heads per KV head
+constexpr int XNT  = 8;          // max query tokens
+constexpr int XR   = XNT * XG;   // query rows per KV head
+constexpr int XKT  = 128;        // keys per tile
+constexpr int XNSG = 16;         // subgroups per work-group
+constexpr int XSG  = 16;         // subgroup size
+constexpr int XTM = 8, XTN = 16, XTK = 16;
+static_assert(XKT == XNSG * XTM, "one 8-key A tile per subgroup");
+static_assert(XD == XNSG * XTN, "one 16-dim output slice per subgroup");
+
+struct xmx_params {
+    const char * Q;  int64_t q_tok, q_head;   // byte strides, f32 data
+    const half * K;  int64_t k_key, k_head;   // element strides
+    const half * V;  int64_t v_key, v_head;
+    const half * mask; int64_t m_tok;         // element stride
+    int   ntok, n_kv, hkv, nsplit, tiles_per;
+    float scale;
+    float * opart;   // [hkv*nsplit][XR][XD]
+    float * meta;    // [hkv*nsplit][XR][2]
+    float * dst;     // [t][hq][XD]
+};
+
+void xmx_attn_launch(sycl::queue & q, const xmx_params & p) {
+    q.submit([&](sycl::handler & h) {
+        sycl::local_accessor<half, 1>  QT(XD * XR, h);
+        sycl::local_accessor<float, 1> ST(XKT * XR, h);
+        sycl::local_accessor<half, 1>  P(XR * XKT, h);
+        sycl::local_accessor<float, 1> stat(3 * XR, h);
+        const xmx_params pp = p;
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) p.hkv * p.nsplit * XNSG * XSG), sycl::range<1>(XNSG * XSG)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(XSG)]] {
+            const auto sg   = it.get_sub_group();
+            const int  sgid = sg.get_group_id()[0];
+            const int  lane = sg.get_local_id()[0];
+            const int  g    = it.get_group(0);
+            const int  kvh  = g / pp.nsplit;
+            const int  sp   = g % pp.nsplit;
+            const int  lid  = it.get_local_id(0);
+
+            float * m_s  = &stat[0];
+            float * l_s  = &stat[XR];
+            float * rs_s = &stat[2 * XR];
+
+            for (int idx = lid; idx < XR * XD; idx += XNSG * XSG) {
+                const int r = idx / XD, d = idx % XD, t = r / XG, hl = r % XG;
+                float v = 0.0f;
+                if (t < pp.ntok) {
+                    v = ((const float *) (pp.Q + t * pp.q_tok + (kvh * XG + hl) * pp.q_head))[d] * pp.scale;
+                }
+                QT[d * XR + r] = (half) v;
+            }
+            for (int r = lid; r < XR; r += XNSG * XSG) { m_s[r] = -3.0e38f; l_s[r] = 0.0f; rs_s[r] = 1.0f; }
+            sycl::group_barrier(it.get_group());
+
+            mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, XTM, XTN> acc[XR / XTM];
+#pragma unroll
+            for (int mi = 0; mi < XR / XTM; ++mi) mx::joint_matrix_fill(sg, acc[mi], 0.0f);
+
+            const auto Kg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+                pp.K + (size_t) kvh * pp.k_head);
+            const auto Vg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+                pp.V + (size_t) kvh * pp.v_head);
+            auto QTp = QT.template get_multi_ptr<sycl::access::decorated::no>();
+            auto STp = ST.template get_multi_ptr<sycl::access::decorated::no>();
+            auto Pp  = P.template get_multi_ptr<sycl::access::decorated::no>();
+
+            const int tile0 = sp * pp.tiles_per;
+            const int tile1 = sycl::min(tile0 + pp.tiles_per, pp.n_kv / XKT);
+            for (int tile = tile0; tile < tile1; ++tile) {
+                const int k0 = tile * XKT;
+
+                mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, XTM, XTN> s[XR / XTN];
+#pragma unroll
+                for (int n = 0; n < XR / XTN; ++n) mx::joint_matrix_fill(sg, s[n], 0.0f);
+#pragma unroll 4
+                for (int kd = 0; kd < XD; kd += XTK) {
+                    mx::joint_matrix<sycl::sub_group, half, mx::use::a, XTM, XTK, mx::layout::row_major> a;
+                    mx::joint_matrix_load(sg, a, Kg + (size_t) (k0 + sgid * XTM) * pp.k_key + kd, pp.k_key);
+#pragma unroll
+                    for (int n = 0; n < XR / XTN; ++n) {
+                        mx::joint_matrix<sycl::sub_group, half, mx::use::b, XTK, XTN, mx::layout::row_major> b;
+                        mx::joint_matrix_load(sg, b, QTp + kd * XR + n * XTN, XR);
+                        mx::joint_matrix_mad(sg, s[n], a, b, s[n]);
+                    }
+                }
+#pragma unroll
+                for (int n = 0; n < XR / XTN; ++n) {
+                    mx::joint_matrix_store(sg, s[n], STp + (sgid * XTM) * XR + n * XTN, XR, mx::layout::row_major);
+                }
+                sycl::group_barrier(it.get_group());
+
+                for (int rr = 0; rr < XR / XNSG; ++rr) {
+                    const int r = sgid * (XR / XNSG) + rr;
+                    const int t = r / XG;
+                    if (t >= pp.ntok) {
+                        for (int k = lane; k < XKT; k += XSG) P[r * XKT + k] = (half) 0.0f;
+                        if (lane == 0) rs_s[r] = 1.0f;
+                        continue;
+                    }
+                    float sv[XKT / XSG];
+                    float mloc = -3.0e38f;
+#pragma unroll
+                    for (int i = 0; i < XKT / XSG; ++i) {
+                        const int k = lane + i * XSG;
+                        sv[i] = ST[k * XR + r] + (float) pp.mask[t * pp.m_tok + k0 + k];
+                        mloc  = sycl::fmax(mloc, sv[i]);
+                    }
+                    const float m_old = m_s[r];
+                    const float m_new = sycl::fmax(m_old, sycl::reduce_over_group(sg, mloc, sycl::maximum<float>()));
+                    float sum = 0.0f;
+#pragma unroll
+                    for (int i = 0; i < XKT / XSG; ++i) {
+                        const float pv = sycl::native::exp(sv[i] - m_new);
+                        sum += pv;
+                        P[r * XKT + lane + i * XSG] = (half) pv;
+                    }
+                    sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+                    if (lane == 0) {
+                        const float sc = sycl::native::exp(m_old - m_new);
+                        rs_s[r] = sc;
+                        l_s[r]  = l_s[r] * sc + sum;
+                        m_s[r]  = m_new;
+                    }
+                }
+                sycl::group_barrier(it.get_group());
+
+#pragma unroll
+                for (int mi = 0; mi < XR / XTM; ++mi) {
+                    mxi::joint_matrix_apply(sg, acc[mi], [=](float & x, size_t row, size_t) { x *= rs_s[mi * XTM + row]; });
+                }
+#pragma unroll
+                for (int kk = 0; kk < XKT; kk += XTK) {
+                    mx::joint_matrix<sycl::sub_group, half, mx::use::b, XTK, XTN, mx::layout::row_major> b;
+                    mx::joint_matrix_load(sg, b, Vg + (size_t) (k0 + kk) * pp.v_key + sgid * XTN, pp.v_key);
+#pragma unroll
+                    for (int mi = 0; mi < XR / XTM; ++mi) {
+                        mx::joint_matrix<sycl::sub_group, half, mx::use::a, XTM, XTK, mx::layout::row_major> a;
+                        mx::joint_matrix_load(sg, a, Pp + (mi * XTM) * XKT + kk, XKT);
+                        mx::joint_matrix_mad(sg, acc[mi], a, b, acc[mi]);
+                    }
+                }
+                sycl::group_barrier(it.get_group());
+            }
+
+            const auto Og = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(
+                pp.opart + (size_t) g * XR * XD);
+#pragma unroll
+            for (int mi = 0; mi < XR / XTM; ++mi) {
+                mx::joint_matrix_store(sg, acc[mi], Og + (mi * XTM) * XD + sgid * XTN, XD, mx::layout::row_major);
+            }
+            for (int r = lid; r < XR; r += XNSG * XSG) {
+                pp.meta[((size_t) g * XR + r) * 2 + 0] = m_s[r];
+                pp.meta[((size_t) g * XR + r) * 2 + 1] = l_s[r];
+            }
+        });
+    });
+
+    const xmx_params pp = p;
+    q.parallel_for(sycl::range<3>(p.ntok, p.hkv * XG, XD), [=](sycl::id<3> id) {
+        const int t = id[0], h = id[1], d = id[2];
+        const int kvh = h / XG, r = t * XG + h % XG;
+        float M = -3.0e38f;
+        for (int s = 0; s < pp.nsplit; ++s) M = sycl::fmax(M, pp.meta[((size_t) (kvh * pp.nsplit + s) * XR + r) * 2]);
+        float num = 0.0f, den = 0.0f;
+        for (int s = 0; s < pp.nsplit; ++s) {
+            const size_t gs = (size_t) kvh * pp.nsplit + s;
+            const float  w  = sycl::native::exp(pp.meta[(gs * XR + r) * 2] - M);
+            num += w * pp.opart[(gs * XR + r) * XD + d];
+            den += w * pp.meta[(gs * XR + r) * 2 + 1];
+        }
+        pp.dst[((size_t) t * pp.hkv * XG + h) * XD + d] = den > 0.0f ? num / den : 0.0f;
+    });
+}
+
+}  // namespace
+
+bool ggml_sycl_flash_attn_ext_xmx(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_FA_XMX", 0) == 1;
+    if (!enabled) {
+        return false;
+    }
+    const ggml_tensor * Q     = dst->src[0];
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    float scale = 1.0f, max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (Q->ne[0] != XD || K->ne[0] != XD || V->ne[0] != XD) {
+        return false;
+    }
+    if (K->ne[2] == 0 || Q->ne[2] != K->ne[2] * XG || V->ne[2] != K->ne[2]) {
+        return false;
+    }
+    if (Q->ne[1] < 1 || Q->ne[1] > XNT || Q->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1) {
+        return false;
+    }
+    if (K->ne[1] % XKT != 0 || V->ne[1] != K->ne[1]) {
+        return false;
+    }
+    if (!mask || mask->type != GGML_TYPE_F16 || mask->ne[0] < K->ne[1] || mask->ne[1] < Q->ne[1] || mask->ne[2] != 1 ||
+        mask->ne[3] != 1 || sinks || max_bias != 0.0f || logit_softcap != 0.0f) {
+        return false;
+    }
+    if (Q->nb[0] != sizeof(float) || K->nb[0] != sizeof(half) || V->nb[0] != sizeof(half) || mask->nb[0] != sizeof(half)) {
+        return false;
+    }
+    for (const ggml_tensor * t : { K, V }) {
+        if (t->nb[1] % sizeof(half) != 0 || t->nb[2] % sizeof(half) != 0) {
+            return false;
+        }
+    }
+    if (!ggml_is_contiguous(dst)) {
+        return false;
+    }
+
+    const int hkv   = (int) K->ne[2];
+    const int n_kv  = (int) K->ne[1];
+    const int tiles = n_kv / XKT;
+    int nsplit = tiles < 128 ? tiles : 128;
+    const int tiles_per = (tiles + nsplit - 1) / nsplit;
+    nsplit = (tiles + tiles_per - 1) / tiles_per;
+
+    ggml_sycl_pool_alloc<float> opart(ctx.pool(), (size_t) hkv * nsplit * XR * XD);
+    ggml_sycl_pool_alloc<float> meta(ctx.pool(), (size_t) hkv * nsplit * XR * 2);
+
+    xmx_params p;
+    p.Q = (const char *) Q->data;          p.q_tok = Q->nb[1];                  p.q_head = Q->nb[2];
+    p.K = (const half *) K->data;          p.k_key = K->nb[1] / sizeof(half);   p.k_head = K->nb[2] / sizeof(half);
+    p.V = (const half *) V->data;          p.v_key = V->nb[1] / sizeof(half);   p.v_head = V->nb[2] / sizeof(half);
+    p.mask = (const half *) mask->data;    p.m_tok = mask->nb[1] / sizeof(half);
+    p.ntok = (int) Q->ne[1]; p.n_kv = n_kv; p.hkv = hkv; p.nsplit = nsplit; p.tiles_per = tiles_per;
+    p.scale = scale;
+    p.opart = opart.get(); p.meta = meta.get(); p.dst = (float *) dst->data;
+
+    xmx_attn_launch(*ctx.stream(), p);
+    return true;
+}
