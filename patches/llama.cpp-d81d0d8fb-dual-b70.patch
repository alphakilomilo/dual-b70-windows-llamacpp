+    const int bpr = K / DP_TK;
+    q.submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> red(KSPLIT * DP_TM * DP_TN, h);
+        h.parallel_for(sycl::nd_range<1>((size_t) (M / DP_TM) * KSPLIT * DP_SG, KSPLIT * DP_SG),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(DP_SG)]] {
+            const auto sg   = it.get_sub_group();
+            const int  s    = sg.get_group_id()[0];
+            const int  row0 = it.get_group(0) * DP_TM;
+            const int  b0   = s * bpr / KSPLIT, b1 = (s + 1) * bpr / KSPLIT;
+            const auto qg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qs);
+            const auto bg = sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(bp);
+
+            float facc[DP_TM * DP_TN / DP_SG] = {};
+            int b = b0;
+            for (; b + UNR <= b1; b += UNR) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> c[UNR];
