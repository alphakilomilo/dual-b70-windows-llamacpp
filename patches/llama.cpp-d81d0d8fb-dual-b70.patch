+                mx::joint_matrix<sycl::sub_group, int8_t, mx::use::a, DP_TM, DP_TK, mx::layout::row_major> a;
+                mx::joint_matrix<sycl::sub_group, int8_t, mx::use::b, DP_TK, DP_TN, mx::layout::ext_intel_packed> bm;
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> c;
+                mx::joint_matrix_load(sg, a, qg + (size_t) row0 * K + (size_t) b * DP_TK, K);
+                mx::joint_matrix_load(sg, bm, bg + (size_t) b * DP_TK * DP_TN, DP_TN * 4);
+                mx::joint_matrix_fill(sg, c, 0);
+                mx::joint_matrix_mad(sg, c, a, bm, c);
+                int e = 0;
+                const float * dab = da + (size_t) b * DP_TN;
+                mxi::joint_matrix_apply(sg, c, [&](int32_t & x, size_t r, size_t col) {
+                    facc[e++] += (float) x * (float) dw[(size_t) (row0 + r) * bpr + b] * dab[col];
+                });
+            }
+
+            mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> coords;
+            mx::joint_matrix_fill(sg, coords, 0);
+            int e = 0;
+            mxi::joint_matrix_apply(sg, coords, [&](int32_t &, size_t r, size_t col) {
+                red[(s * DP_TM + r) * DP_TN + col] = facc[e++];
+            });
+            sycl::group_barrier(it.get_group());
+            for (int idx = it.get_local_id(0); idx < DP_TM * DP_TN; idx += KSPLIT * DP_SG) {
+                const int r = idx / DP_TN, col = idx % DP_TN;
