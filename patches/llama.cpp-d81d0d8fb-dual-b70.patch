+//       exchange) and writes own + peer.
+// Same arithmetic as the symmetric bf16 / F32 paths, so both replicas stay bit-identical. Ping-pong parity makes
+// buffer reuse safe: a device overwrites buffer p again only two exchanges later, after the peer has signalled the
+// intervening exchange, which it does only after finishing its read of buffer p.
+template <typename T>
+static void ggml_sycl_fused_ar_device(queue_ptr q, float * out, T * host_mine, const T * host_peer, uint32_t * flag_mine,
+                                      const uint32_t * flag_peer, uint32_t * err, uint32_t seq, int64_t nelem) {
+    using sys_atomic = sycl::atomic_ref<uint32_t, sycl::memory_order::relaxed, sycl::memory_scope::system,
+                                        sycl::access::address_space::global_space>;
+    constexpr bool is_bf16 = std::is_same<T, uint16_t>::value;
+    auto to_wire = [](float x) -> T {
+        if constexpr (is_bf16) {
+            const uint32_t u = sycl::bit_cast<uint32_t>(x);
+            return (uint16_t) ((u + 0x7FFFu + ((u >> 16) & 1u)) >> 16);
+        } else {
+            return x;
+        }
+    };
+    auto from_wire = [](T v) -> float {
+        if constexpr (is_bf16) {
+            return sycl::bit_cast<float>(((uint32_t) v) << 16);
+        } else {
+            return v;
+        }
+    };
+    // K1: partial -> pinned host
+    q->parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) { host_mine[i] = to_wire(out[i]); });
+    // K2: publish, join, read peer, sum
+    constexpr int wg = 256;
+    const size_t global = ((size_t) nelem + wg - 1) / wg * wg;
+    q->parallel_for(sycl::nd_range<1>(global, wg), [=](sycl::nd_item<1> it) {
+        namespace sxe = sycl::ext::intel::experimental;
+        namespace sxo = sycl::ext::oneapi::experimental;
+        if (it.get_global_id(0) == 0) {
+            sys_atomic(*flag_mine).store(seq, sycl::memory_order::release);
+        }
+        if (it.get_local_id(0) == 0) {
+            sxo::annotated_ptr<const volatile uint32_t, decltype(sxo::properties(
+                sxe::read_hint<sxe::cache_control<sxe::cache_mode::uncached, sxe::cache_level::L1, sxe::cache_level::L3>>))> fp(flag_peer);
+            uint32_t k = 0;
+            while (*fp < seq) {
+                if (++k > 600000u) { *err = seq; break; }
+            }
+        }
+        sycl::group_barrier(it.get_group());
+        const size_t i = it.get_global_id(0);
+        if (i < (size_t) nelem) {
+            sxo::annotated_ptr<const volatile T, decltype(sxo::properties(
+                sxe::read_hint<sxe::cache_control<sxe::cache_mode::uncached, sxe::cache_level::L1, sxe::cache_level::L3>>))> pp(host_peer);
+            const T peer = pp[i];
+            out[i] = from_wire(to_wire(out[i])) + from_wire(peer);
+        }
+    });
+}
