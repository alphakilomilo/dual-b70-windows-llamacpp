+                for (int u = 0; u < UNR; ++u) {
+                    mx::joint_matrix<sycl::sub_group, int8_t, mx::use::a, DP_TM, DP_TK, mx::layout::row_major> a;
+                    mx::joint_matrix<sycl::sub_group, int8_t, mx::use::b, DP_TK, DP_TN, mx::layout::ext_intel_packed> bm;
+                    mx::joint_matrix_load(sg, a, qg + (size_t) row0 * K + (size_t) (b + u) * DP_TK, K);
+                    mx::joint_matrix_load(sg, bm, bg + (size_t) (b + u) * DP_TK * DP_TN, DP_TN * 4);
+                    mx::joint_matrix_fill(sg, c[u], 0);
+                    mx::joint_matrix_mad(sg, c[u], a, bm, c[u]);
+                }
