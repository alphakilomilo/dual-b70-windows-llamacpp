+// Integer-DPAS GEMV for reordered Q8_0 weights x 2..8 tokens on Intel Xe2 (Arc Pro B70).
+//
+//   A = weights, 8 rows x 32 int8 = one Q8_0 block per row, loaded straight from the reordered layout
+//       (row-major qs for all blocks, then the fp16 scales: see block_q_t<GGML_TYPE_Q8_0>)
+//   B = activations quantized per 32-block to int8 (d = amax/127, like q8_1) in the packed VNNI-4 layout
+//       [K/4][16][4]; tokens fill columns 0..ntok-1, the rest are zero
+//   C = 8 x 16 int32 per block, scaled by d_w[row][blk] * d_a[blk][tok] into per-lane float accumulators
+// A work-group (KSPLIT sub-groups) owns an 8-row tile and splits K; partial sums are reduced in SLM.
+// Standalone measurement (experimental/int8-dpas-2026-10-22), 8 tokens, per GPU: 8704x5120 85 vs 117 us,
+// 5120x8704 87 vs 119 us, 248320x5120 2314 vs 2967 us -- about 550-600 GB/s, where the dp4a kernel reached ~400.
+
+#include <sycl/sycl.hpp>
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+#include "mmvq-dpas.hpp"
+
+namespace {
+
+namespace mx  = sycl::ext::oneapi::experimental::matrix;
+namespace mxi = sycl::ext::intel::experimental::matrix;
+using half    = sycl::half;
+
+constexpr int DP_TM = 8, DP_TN = 16, DP_TK = 32;
+constexpr int DP_SG = 16;
+
+// x: ntok rows of K floats (row stride sx floats) -> bp [K/4][16][4] int8, da [K/32][16] float
+void dpas_quantize(sycl::queue & q, const float * x, int64_t sx, int ntok, int K, int8_t * bp, float * da) {
+    const int bpr = K / DP_TK;
+    q.parallel_for(sycl::range<2>((size_t) bpr, DP_TN), [=](sycl::id<2> id) {
+        const int b = (int) id[0], n = (int) id[1];
+        float d = 0.0f;
+        float v[DP_TK];
+        if (n < ntok) {
+            float amax = 0.0f;
+#pragma unroll
+            for (int k = 0; k < DP_TK; ++k) {
+                v[k] = x[(size_t) n * sx + (size_t) b * DP_TK + k];
+                amax = sycl::fmax(amax, sycl::fabs(v[k]));
+            }
+            d = amax / 127.0f;
+        }
+        const float id_ = d > 0.0f ? 1.0f / d : 0.0f;
+#pragma unroll
+        for (int k = 0; k < DP_TK; ++k) {
+            const int kk = b * DP_TK + k;
+            const int8_t qv = n < ntok ? (int8_t) sycl::round(v[k] * id_) : (int8_t) 0;
+            bp[((size_t) (kk / 4) * DP_TN + n) * 4 + kk % 4] = qv;
+        }
+        da[(size_t) b * DP_TN + n] = d;
+    });
+}
