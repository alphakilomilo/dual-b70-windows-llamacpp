+// GGML_SYCL_PER_DEVICE_CONTEXT=1: give every Level Zero GPU its own SYCL context, all wrapping the platform default
+// context's single native Level Zero context. Works around a DPC++ (oneAPI 2026.1) fast-kernel-cache leak: when one
+// kernel runs on two devices of the same SYCL context, every device switch misses the cache and saveKernel() appends
+// a (kernel name, device) record that is never freed (~170 B per launch; tensor parallel alternates devices thousands
+// of times per decode, 90+ GB host memory after a long session). One device per SYCL context means no misses. USM
+// stays shared at the Level Zero level, so host buffers allocated through one GPU's context still work on the other.
+inline sycl::context ggml_sycl_queue_context(const sycl::device & device) {
+    static const bool per_device = [] {
+        const char * e = std::getenv("GGML_SYCL_PER_DEVICE_CONTEXT");
+        return e != nullptr && std::atoi(e) != 0;
+    }();
+    const sycl::context shared = device.get_platform().khr_get_default_context();
+    if (!per_device || !device.is_gpu() || device.get_backend() != sycl::backend::ext_oneapi_level_zero) {
+        return shared;
+    }
+    static std::mutex mtx;
+    static std::vector<std::pair<sycl::device, sycl::context>> made;
+    std::lock_guard<std::mutex> lock(mtx);
+    for (const auto & [d, c] : made) {
+        if (d == device) {
+            return c;
+        }
+    }
+    const auto native = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(shared);
+    sycl::context ctx = sycl::make_context<sycl::backend::ext_oneapi_level_zero>(
+        sycl::backend_input_t<sycl::backend::ext_oneapi_level_zero, sycl::context>{
+            native, { device }, sycl::ext::oneapi::level_zero::ownership::keep });
+    made.emplace_back(device, ctx);
+    return ctx;
+}
+
+// two queues whose USM is mutually usable: the same SYCL context, or per-device contexts over one native L0 context
+inline bool ggml_sycl_same_native_context(const sycl::queue & a, const sycl::queue & b) {
+    if (a.get_context() == b.get_context()) {
+        return true;
+    }
+    if (a.get_backend() != sycl::backend::ext_oneapi_level_zero || b.get_backend() != sycl::backend::ext_oneapi_level_zero) {
+        return false;
+    }
+    return sycl::get_native<sycl::backend::ext_oneapi_level_zero>(a.get_context()) ==
+           sycl::get_native<sycl::backend::ext_oneapi_level_zero>(b.get_context());
+}
