+            mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> coords;
+            mx::joint_matrix_fill(sg, coords, 0);
+            int e = 0;
+            mxi::joint_matrix_apply(sg, coords, [&](int32_t &, size_t r, size_t col) {
+                red[((0 * KSPLIT + s) * DP_TM + r) * DP_TN + col] = fu[e];
+                red[((1 * KSPLIT + s) * DP_TM + r) * DP_TN + col] = fg[e];
+                ++e;
+            });
+            sycl::group_barrier(it.get_group());
+            for (int idx = it.get_local_id(0); idx < DP_TM * DP_TN; idx += KSPLIT * DP_SG) {
+                const int r = idx / DP_TN, col = idx % DP_TN;
+                if (col < ntok) {
+                    float up = 0.0f, gate = 0.0f;
+#pragma unroll
+                    for (int k = 0; k < KSPLIT; ++k) {
+                        up   += red[((0 * KSPLIT + k) * DP_TM + r) * DP_TN + col];
+                        gate += red[((1 * KSPLIT + k) * DP_TM + r) * DP_TN + col];
+                    }
+                    out[(size_t) col * s_out + row0 + r] = gate / (1.0f + sycl::native::exp(-gate)) * up;
+                }
+            }
+        });
+    });
+}
+
+}  // namespace
+
+bool ggml_sycl_q8_dpas_swiglu(ggml_backend_sycl_context & ctx, const void * wu, const void * wg, const float * act,
+                              int64_t act_stride, int ntok, int K, int M, float * out, int64_t out_stride) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS", 0) == 1;
+    static const bool fused   = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS_FUSED_GLU", 0) == 1;
+    if (!enabled || !fused || ntok < 2 || ntok > DP_TN / 2 || K % DP_TK != 0 || M % DP_TM != 0) {
+        return false;
+    }
+    queue_ptr stream = ctx.stream();
+    const int bpr = K / DP_TK;
+    ggml_sycl_pool_alloc<int8_t> bp(ctx.pool(), (size_t) K * DP_TN);
+    ggml_sycl_pool_alloc<float>  da(ctx.pool(), (size_t) bpr * DP_TN);
+    dpas_quantize(*stream, act, act_stride, ntok, K, bp.get(), da.get());
+    const int8_t * qu = (const int8_t *) wu;
+    const int8_t * qg = (const int8_t *) wg;
+    const half *   du = (const half *) ((const char *) wu + (size_t) M * K);
+    const half *   dg = (const half *) ((const char *) wg + (size_t) M * K);
+    if (K <= 4096) {
+        dpas_glu_swiglu<2, 2>(*stream, qu, du, qg, dg, bp.get(), da.get(), out, out_stride, M, K, ntok);
+    } else {
+        dpas_glu_swiglu<8, 2>(*stream, qu, du, qg, dg, bp.get(), da.get(), out, out_stride, M, K, ntok);
+    }
+    return true;
+}
+
+bool ggml_sycl_q8_dpas_glu_pair(ggml_backend_sycl_context & ctx, const void * wu, const void * wg, const float * act,
+                                int64_t act_stride, int ntok, int K, int M, float * up_out, float * gate_out) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS", 0) == 1;
+    if (!enabled || ntok < 2 || ntok > DP_TN / 2 || K % DP_TK != 0 || M % DP_TM != 0) {
+        return false;
+    }
+    queue_ptr stream = ctx.stream();
+    const int bpr = K / DP_TK;
+    ggml_sycl_pool_alloc<int8_t> bp(ctx.pool(), (size_t) K * DP_TN);
+    ggml_sycl_pool_alloc<float>  da(ctx.pool(), (size_t) bpr * DP_TN);
+    dpas_quantize(*stream, act, act_stride, ntok, K, bp.get(), da.get());
+    const void * w[2]   = { wu, wg };
+    float *      out[2] = { up_out, gate_out };
+    for (int i = 0; i < 2; ++i) {
+        const int8_t * qs = (const int8_t *) w[i];
+        const half *   dw = (const half *) ((const char *) w[i] + (size_t) M * K);
+        if (K <= 4096) {
+            dpas_gemv<2, 4>(*stream, qs, dw, bp.get(), da.get(), out[i], M, M, K, ntok);
+        } else {
+            dpas_gemv<8, 4>(*stream, qs, dw, bp.get(), da.get(), out[i], M, M, K, ntok);
+        }
+    }
+    return true;
+}
+
+bool ggml_sycl_mul_mat_q8_dpas(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                               ggml_tensor * dst) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_Q8_DPAS", 0) == 1;
+    if (!enabled) {
+        return false;
+    }
+    const int64_t K = src0->ne[0], M = src0->ne[1], ntok = src1->ne[1];
+    if (src0->type != GGML_TYPE_Q8_0 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        ntok < 2 || ntok > DP_TN / 2 || K % DP_TK != 0 || M % DP_TM != 0 ||
+        src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->ne[0] != K ||
+        !ggml_is_contiguous(src0) || src1->nb[0] != sizeof(float) || !ggml_is_contiguous(dst) || dst->ne[0] != M) {
+        return false;
+    }
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (!extra || !extra->optimized_feature.reorder) {
+        return false;  // the A loads assume the reordered layout (row-major qs, then scales)
+    }
+    static bool logged = false;
+    if (!logged) {
+        GGML_LOG_WARN("%s: GGML_SYCL_Q8_DPAS active (integer DPAS for 2..8-token Q8_0 mul_mat)\n", __func__);
+        logged = true;
+    }
+    queue_ptr stream = ctx.stream();
+    const int bpr = (int) (K / DP_TK);
+    ggml_sycl_pool_alloc<int8_t> bp(ctx.pool(), (size_t) K * DP_TN);
+    ggml_sycl_pool_alloc<float>  da(ctx.pool(), (size_t) bpr * DP_TN);
+
+    const int8_t * qs = (const int8_t *) src0->data;
+    const half *   dw = (const half *) ((const char *) src0->data + (size_t) M * K);
+
+    dpas_quantize(*stream, (const float *) src1->data, (int64_t) (src1->nb[1] / sizeof(float)), (int) ntok, (int) K,
+                  bp.get(), da.get());
+    float * out = (float *) dst->data;
+    const int64_t s_out = (int64_t) (dst->nb[1] / sizeof(float));
+    if (K <= 4096) {
+        dpas_gemv<2, 4>(*stream, qs, dw, bp.get(), da.get(), out, s_out, (int) M, (int) K, (int) ntok);
+    } else {
+        dpas_gemv<8, 4>(*stream, qs, dw, bp.get(), da.get(), out, s_out, (int) M, (int) K, (int) ntok);
+    }
+    return true;
+}
