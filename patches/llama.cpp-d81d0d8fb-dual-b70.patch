+            float fu[DP_TM * DP_TN / DP_SG] = {};
+            float fg[DP_TM * DP_TN / DP_SG] = {};
+            auto step = [&](int bb, auto & cu, auto & cg) {
+                mx::joint_matrix<sycl::sub_group, int8_t, mx::use::a, DP_TM, DP_TK, mx::layout::row_major> au, ag;
+                mx::joint_matrix<sycl::sub_group, int8_t, mx::use::b, DP_TK, DP_TN, mx::layout::ext_intel_packed> bm;
+                mx::joint_matrix_load(sg, bm, bg + (size_t) bb * DP_TK * DP_TN, DP_TN * 4);
+                mx::joint_matrix_load(sg, au, ug + (size_t) row0 * K + (size_t) bb * DP_TK, K);
+                mx::joint_matrix_load(sg, ag, gg + (size_t) row0 * K + (size_t) bb * DP_TK, K);
+                mx::joint_matrix_fill(sg, cu, 0);
+                mx::joint_matrix_fill(sg, cg, 0);
+                mx::joint_matrix_mad(sg, cu, au, bm, cu);
+                mx::joint_matrix_mad(sg, cg, ag, bm, cg);
+            };
+            auto accum = [&](int bb, auto & cu, auto & cg) {
+                const float * dab = da + (size_t) bb * DP_TN;
+                int e = 0;
+                mxi::joint_matrix_apply(sg, cu, [&](int32_t & x, size_t r, size_t col) {
+                    fu[e++] += (float) x * (float) du[(size_t) (row0 + r) * bpr + bb] * dab[col];
+                });
+                e = 0;
+                mxi::joint_matrix_apply(sg, cg, [&](int32_t & x, size_t r, size_t col) {
+                    fg[e++] += (float) x * (float) dg[(size_t) (row0 + r) * bpr + bb] * dab[col];
+                });
+            };
+            int b = b0;
+            for (; b + UNR <= b1; b += UNR) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> cu[UNR], cg[UNR];
+#pragma unroll
+                for (int u = 0; u < UNR; ++u) step(b + u, cu[u], cg[u]);
+#pragma unroll
+                for (int u = 0; u < UNR; ++u) accum(b + u, cu[u], cg[u]);
+            }
+            for (; b < b1; ++b) {
+                mx::joint_matrix<sycl::sub_group, int32_t, mx::use::accumulator, DP_TM, DP_TN> cu, cg;
+                step(b, cu, cg);
+                accum(b, cu, cg);
+            }
