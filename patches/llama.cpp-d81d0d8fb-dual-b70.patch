+// Strided host<->device copies: n_copies rows of `size` bytes, rows `stride_tensor` apart on the device and
+// `stride_data` apart on the host. Without these, ggml falls back to one synchronous copy per row; tensor parallel
+// reads/writes every split KV row that way (a 40 MiB draft-cache checkpoint took ~250 ms, i.e. ~160 MB/s).
+// The device side is one bulk copy when its rows are dense (or nearly so); the host side is scattered on the CPU.
+static void ggml_backend_sycl_buffer_get_tensor_2d(ggml_backend_buffer_t buffer, const ggml_tensor * tensor,
+                                                   void * data, size_t offset, size_t size, size_t n_copies,
+                                                   size_t stride_tensor, size_t stride_data) try {
+    const size_t span = (n_copies - 1) * stride_tensor + size;  // device bytes covering all rows
+    if (n_copies <= 1 || stride_tensor < size || span > 2 * n_copies * size) {
+        for (size_t i = 0; i < n_copies; i++) {
+            ggml_backend_sycl_buffer_get_tensor(buffer, tensor, (char *) data + i * stride_data, offset + i * stride_tensor, size);
+        }
+        return;
+    }
+    if (stride_data == stride_tensor) {
+        ggml_backend_sycl_buffer_get_tensor(buffer, tensor, data, offset, span);
+        return;
+    }
+    std::vector<char> tmp(span);
+    ggml_backend_sycl_buffer_get_tensor(buffer, tensor, tmp.data(), offset, span);
+    for (size_t i = 0; i < n_copies; i++) {
+        memcpy((char *) data + i * stride_data, tmp.data() + i * stride_tensor, size);
+    }
